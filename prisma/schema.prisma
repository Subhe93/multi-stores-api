generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. المستخدمون والمصادقة
// ==========================================

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password_hash String
  role          UserRole
  status        UserStatus @default(PENDING)
  avatar_url    String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  provider Provider?
  creator  Creator?
  customer Customer?
  sessions Session[]

  @@index([email])
  @@index([role, status])
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}

enum UserRole {
  ADMIN
  PROVIDER
  CREATOR
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

// ==========================================
// 2. Provider (المزود)
// ==========================================

model Provider {
  id                String   @id @default(uuid())
  user_id           String   @unique
  company_name      String
  description       String?
  logo_url          String?
  phone             String?
  country           String
  stripe_account_id String?
  // Stripe Connect onboarding state, kept in sync via the account.updated webhook.
  stripe_charges_enabled         Boolean   @default(false)
  stripe_payouts_enabled         Boolean   @default(false)
  stripe_onboarding_completed_at DateTime?
  verified          Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  products   Product[]
  promotions Promotion[]
}

// ==========================================
// 3. Creator (المبدع)
// ==========================================

model Creator {
  id                String   @id @default(uuid())
  user_id           String   @unique
  display_name      String
  bio               String?
  avatar_url        String?
  cover_url         String?
  phone             String?
  stripe_account_id String?
  // Connected account type: 'express' (marketplace transfers model) or
  // 'standard' (independent stores charging directly on their own account).
  stripe_account_type String?
  // Stripe Connect onboarding state, kept in sync via the account.updated webhook.
  stripe_charges_enabled        Boolean   @default(false)
  stripe_payouts_enabled        Boolean   @default(false)
  stripe_onboarding_completed_at DateTime?
  verified          Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  own_products       Product[]
  store              Store?
  custom_products    CustomProduct[]
  promotions         Promotion[]
  bundles            Bundle[]
  creator_categories CreatorCategory[]
}

// ==========================================
// 4. Customer (العميل)
// ==========================================

model Customer {
  id         String   @id @default(uuid())
  user_id    String   @unique
  first_name String
  last_name  String
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]
  cart      Cart?
}

model Address {
  id           String   @id @default(uuid())
  customer_id  String
  label        String?
  full_name    String
  line1        String
  line2        String?
  city         String
  state        String?
  postal_code  String
  country_code String   @db.VarChar(2)
  phone        String?
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customer_id])
}

// ==========================================
// 5. الفئات (Categories)
// ==========================================

model Category {
  id         String  @id @default(uuid())
  parent_id  String?
  slug       String  @unique
  icon       String?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  parent              Category?                  @relation("CategoryTree", fields: [parent_id], references: [id])
  children            Category[]                 @relation("CategoryTree")
  translations        CategoryTranslation[]
  attribute_templates CategoryAttributeTemplate[]
  products            Product[]
}

model CategoryTranslation {
  id          String @id @default(uuid())
  category_id String
  locale      String @db.VarChar(5)
  name        String
  description String?

  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, locale])
}

// ==========================================
// 5b. تصنيفات الكرييتور (Creator Collections)
// ==========================================
// Creator-scoped grouping of products (Shopify-style Collections), independent
// of the admin-managed global Category taxonomy. A creator can nest these into
// sub-collections via parent_id and include products either manually or by tag.

enum CreatorCategoryMatchRule {
  MANUAL
  TAGS
}

model CreatorCategory {
  id            String                   @id @default(uuid())
  creator_id    String
  parent_id     String?
  slug          String
  thumbnail_url String?
  match_rule    CreatorCategoryMatchRule @default(MANUAL)
  match_tags    String[]
  sort_order    Int                      @default(0)
  is_active     Boolean                  @default(true)
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt

  creator         Creator                        @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  parent          CreatorCategory?               @relation("CreatorCategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children        CreatorCategory[]              @relation("CreatorCategoryTree")
  translations    CreatorCategoryTranslation[]
  products        ProductCreatorCategory[]
  custom_products CustomProductCreatorCategory[]

  @@unique([creator_id, slug])
  @@index([creator_id, parent_id])
}

model CreatorCategoryTranslation {
  id                  String  @id @default(uuid())
  creator_category_id String
  locale              String  @db.VarChar(5)
  name                String
  description         String?

  creator_category CreatorCategory @relation(fields: [creator_category_id], references: [id], onDelete: Cascade)

  @@unique([creator_category_id, locale])
}

model ProductCreatorCategory {
  product_id          String
  creator_category_id String
  sort_order          Int    @default(0)

  product          Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  creator_category CreatorCategory @relation(fields: [creator_category_id], references: [id], onDelete: Cascade)

  @@id([product_id, creator_category_id])
  @@index([creator_category_id])
}

// ==========================================
// 6. قوالب المواصفات (Attribute Templates)
// ==========================================

model AttributeTemplate {
  id               String        @id @default(uuid())
  name             String        // مفتاح داخلي: "fabric", "wood_type"
  type             AttributeType
  unit             String?       // "cm", "mm", "gsm"
  options          Json?         // ["cotton", "polyester"]
  is_required      Boolean       @default(false)
  group_name       String?       // "المادة", "الأبعاد"
  validation_rules Json?         // { min, max, pattern }
  sort_order       Int           @default(0)

  translations AttributeTemplateTranslation[]
  categories   CategoryAttributeTemplate[]
  values       ProductAttribute[]
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  BOOLEAN
  COLOR
  DIMENSIONS
}

model AttributeTemplateTranslation {
  id            String @id @default(uuid())
  template_id   String
  locale        String @db.VarChar(5)
  label         String // "نوع القماش"
  option_labels Json?  // {"cotton": "قطن"}

  template AttributeTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, locale])
}

model CategoryAttributeTemplate {
  category_id String
  template_id String

  category Category          @relation(fields: [category_id], references: [id], onDelete: Cascade)
  template AttributeTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@id([category_id, template_id])
}

// ==========================================
// 7. المنتجات (Products)
// ==========================================

model Product {
  id                 String             @id @default(uuid())
  provider_id        String?
  creator_id         String?
  category_id        String
  product_type       ProductType
  customization_type CustomizationType?
  base_price         Decimal            @db.Decimal(10, 2)
  compare_at_price   Decimal?           @db.Decimal(10, 2)
  cost_price         Decimal?           @db.Decimal(10, 2)
  sku                String?
  track_inventory    Boolean            @default(false)
  stock_quantity     Int?
  weight                Decimal?           @db.Decimal(8, 2)
  weight_unit           String?            @default("kg")
  variant_option_config Json?
  shipping_profile_id   String?
  status                ProductStatus      @default(DRAFT)
  is_featured        Boolean            @default(false)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  provider         Provider?            @relation(fields: [provider_id], references: [id])
  creator          Creator?             @relation(fields: [creator_id], references: [id])
  category         Category             @relation(fields: [category_id], references: [id])
  shipping_profile ShippingProfile?     @relation(fields: [shipping_profile_id], references: [id], onDelete: SetNull)
  translations       ProductTranslation[]
  images             ProductImage[]
  attributes         ProductAttribute[]
  variants           ProductVariant[]
  tags               ProductTag[]
  custom_fields      ProductCustomField[]
  faqs               ProductFaq[]
  custom_products    CustomProduct[]
  order_items        OrderItem[]
  bundles            BundleProduct[]
  creator_categories ProductCreatorCategory[]

  @@index([provider_id])
  @@index([creator_id])
  @@index([category_id])
  @@index([status])
  @@index([product_type])
}

enum ProductType {
  TRADITIONAL
  CUSTOMIZABLE
}

enum CustomizationType {
  PRINT
  ENGRAVE
  PRINT_3D
  EMBROIDERY
  HANDMADE
  HEAT_PRESS
  SCREEN_PRINT
  UV_PRINT
  CNC
  OTHER
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum ImportMode {
  AS_IS
  CUSTOMIZE
}

enum PricingType {
  SINGLE
  PER_VARIANT
  MARGIN
}

model ProductTranslation {
  id          String  @id @default(uuid())
  product_id  String
  locale      String  @db.VarChar(5)
  title       String
  description String
  slug        String
  meta_title  String?
  meta_desc   String?

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, locale])
  @@index([slug])
}

model ProductImage {
  id          String  @id @default(uuid())
  product_id  String
  variant_id  String?
  url         String
  alt_text    String?
  sort_order  Int     @default(0)
  is_featured Boolean @default(false)

  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id])
}

model ProductAttribute {
  id          String @id @default(uuid())
  product_id  String
  template_id String
  value       Json

  product  Product           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  template AttributeTemplate @relation(fields: [template_id], references: [id])

  @@unique([product_id, template_id])
}

model ProductTag {
  id         String @id @default(uuid())
  product_id String
  tag        String

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([tag])
}

// ==========================================
// 8. المتغيرات (Variants)
// ==========================================

model ProductVariant {
  id                 String   @id @default(uuid())
  product_id         String
  sku                String?  @unique
  price_adjustment   Decimal  @default(0) @db.Decimal(10, 2)
  compare_at_price   Decimal? @db.Decimal(10, 2)
  stock_quantity     Int?
  is_active          Boolean  @default(true)
  options            Json     // { "size": "L", "color": "black" }

  product                 Product                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  images                  ProductImage[]
  order_items             OrderItem[]
  custom_product_variants CustomProductVariant[]

  @@index([product_id])
}

// ==========================================
// 9. الشحن (Shipping)
// ==========================================

model ShippingProfile {
  id          String  @id @default(uuid())
  provider_id String?
  creator_id  String?
  name        String
  is_default  Boolean @default(false)
  created_at  DateTime @default(now())

  zones    ShippingZone[]
  products Product[]
}

model ShippingZone {
  id                 String  @id @default(uuid())
  profile_id         String
  name               String
  countries          String[]
  base_cost          Decimal @db.Decimal(10, 2)
  per_item_cost      Decimal @default(0) @db.Decimal(10, 2)
  free_threshold     Decimal? @db.Decimal(10, 2)
  estimated_days_min Int
  estimated_days_max Int

  profile ShippingProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

// ==========================================
// 10. السلة (Cart)
// ==========================================

model Cart {
  id          String   @id @default(uuid())
  customer_id String   @unique
  store_id    String?
  updated_at  DateTime @updatedAt

  customer Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id                String  @id @default(uuid())
  cart_id           String
  product_id        String?
  variant_id        String?
  custom_product_id String?
  bundle_offer_id   String?
  quantity          Int     @default(1)
  custom_fields     Json?

  cart         Cart         @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  bundle_offer BundleOffer? @relation(fields: [bundle_offer_id], references: [id], onDelete: SetNull)

  @@index([cart_id])
  @@index([bundle_offer_id])
}

// ==========================================
// 11. الطلبات (Orders)
// ==========================================

model Order {
  id              String      @id @default(uuid())
  order_number    String      @unique
  customer_id     String
  address_id      String
  store_id        String?
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  shipping_cost   Decimal     @default(0) @db.Decimal(10, 2)
  discount_amount Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("EUR") @db.VarChar(3)
  payment_method  PaymentMethod @default(COD)
  payment_status  String?
  stripe_payment_id String?
  // Snapshot of the connected account a direct-charge PaymentIntent was created
  // on (independent stores). Null = the payment was charged on the platform.
  stripe_account_id String?
  // Stripe payment details captured from the webhook for tracking/reconciliation.
  stripe_charge_id        String?
  card_brand              String?
  card_last4              String?   @db.VarChar(4)
  receipt_url             String?
  paid_at                 DateTime?
  payment_failure_code    String?
  payment_failure_message String?
  notes           String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  customer   Customer         @relation(fields: [customer_id], references: [id])
  address    Address          @relation(fields: [address_id], references: [id])
  items      OrderItem[]
  commission      OrderCommission?
  timeline        OrderTimeline[]
  promotion_usage PromotionUsage[]
  payouts         OrderPayout[]

  @@index([customer_id])
  @@index([order_number])
  @@index([status])
}

// Per-recipient payout (Stripe transfer) for an order — lets each provider /
// creator track what they were paid, and the admin see the full split.
model OrderPayout {
  id                String        @id @default(uuid())
  order_id          String
  recipient_type    FulfillerType
  recipient_id      String
  stripe_account_id String?
  stripe_transfer_id String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EUR") @db.VarChar(3)
  status            String        @default("paid")
  error             String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, recipient_type, recipient_id])
  @@index([recipient_id])
  @@index([order_id])
}

enum PaymentMethod {
  COD
  STRIPE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  MANUFACTURING
  QUALITY_CHECK
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

model OrderItem {
  id                 String            @id @default(uuid())
  order_id           String
  product_id         String?
  variant_id         String?
  custom_product_id  String?
  bundle_offer_id    String?
  quantity           Int
  unit_price         Decimal           @db.Decimal(10, 2)
  original_unit_price Decimal?         @db.Decimal(10, 2)
  total_price        Decimal           @db.Decimal(10, 2)
  // Unscaled base price owed to this item's provider (0 for creator-only items).
  // Used to split Connect payout transfers per provider after payment succeeds.
  provider_base_amount Decimal         @default(0) @db.Decimal(10, 2)
  customer_design_url String?
  design_notes       String?
  fulfiller_type     FulfillerType
  fulfiller_id       String
  fulfillment_status FulfillmentStatus @default(PENDING)
  tracking_number    String?
  tracking_url       String?

  order              Order                  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product            Product?               @relation(fields: [product_id], references: [id])
  variant            ProductVariant?        @relation(fields: [variant_id], references: [id])
  custom_product     CustomProduct?         @relation(fields: [custom_product_id], references: [id])
  bundle_offer       BundleOffer?           @relation(fields: [bundle_offer_id], references: [id], onDelete: SetNull)
  custom_field_values OrderCustomFieldValue[]

  @@index([order_id])
  @@index([fulfiller_id])
  @@index([bundle_offer_id])
}

enum FulfillerType {
  PROVIDER
  CREATOR
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  MANUFACTURING
  SHIPPED
  DELIVERED
}

model OrderTimeline {
  id         String   @id @default(uuid())
  order_id   String
  status     String
  note       String?
  actor      String?
  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

// ==========================================
// 12. العمولات (Commissions)
// ==========================================

model OrderCommission {
  id              String           @id @default(uuid())
  order_id        String           @unique
  provider_amount Decimal          @default(0) @db.Decimal(10, 2)
  platform_amount Decimal          @db.Decimal(10, 2)
  creator_amount  Decimal          @default(0) @db.Decimal(10, 2)
  currency        String           @default("EUR") @db.VarChar(3)
  status          CommissionStatus @default(PENDING)
  created_at      DateTime         @default(now())

  order Order @relation(fields: [order_id], references: [id])
}

enum CommissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PlatformConfig {
  id               String   @id @default(uuid())

  // Commission
  commission_type  String   @default("percentage")
  commission_value Decimal  @default(15) @db.Decimal(5, 2)

  // Currency & Locale
  default_currency String   @default("EUR")
  default_locale   String   @default("en")
  supported_locales String[] @default(["en"])

  // Platform Info
  platform_name    String   @default("Multi Stores")
  support_email    String?

  // Order Limits
  min_order_amount Decimal? @db.Decimal(10, 2)

  // Registration Approvals
  require_provider_approval Boolean @default(true)
  require_creator_approval  Boolean @default(true)

  // Platform Stripe account (managed from the admin dashboard). These override
  // the STRIPE_* environment variables when set. Secrets are never returned by
  // the shared platform-config endpoint — only via the admin-only payments API.
  stripe_secret_key      String?
  stripe_publishable_key String?
  stripe_webhook_secret  String?
  // Signing secret of the Connect (connected accounts) webhook endpoint,
  // used to verify direct-charge events from independent stores.
  stripe_connect_webhook_secret String?

  // Platform SMTP email settings (managed from the admin dashboard). Override
  // the SMTP_*/MAIL_FROM environment variables when set. Credentials are never
  // returned by the shared platform-config endpoint — only via the admin mail API.
  smtp_host   String?
  smtp_port   Int?
  smtp_secure Boolean  @default(false)
  smtp_user   String?
  smtp_pass   String?
  mail_from   String?

  updated_at       DateTime @updatedAt
}

// Platform-level legal pages (privacy, terms, refund policy, shipping policy).
// Admin-managed; per-locale title + content stored as JSON so a single row
// holds all translations for one slug.
model LegalPage {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      Json     @default("{}")   // { en: "Privacy Policy", ar: "سياسة الخصوصية", ... }
  content    Json     @default("{}")   // { en: "<html>...</html>", ar: "...", ... }
  updated_at DateTime @updatedAt
}

// Admin-managed transactional notification templates. One row per `event`
// (order_confirmation, password_reset, …). Subject + HTML/text bodies are
// per-locale JSON. `enabled=false` suppresses sending for that event entirely.
// Bodies use `{{var}}` placeholders the MailService substitutes at send time.
model NotificationTemplate {
  id         String   @id @default(uuid())
  event      String   @unique
  subject    Json     @default("{}")   // per-locale
  body_html  Json     @default("{}")   // per-locale (HTML)
  body_text  Json     @default("{}")   // per-locale (plain text)
  enabled    Boolean  @default(true)
  updated_at DateTime @updatedAt
}

// ==========================================
// 13. المتجر (Store)
// ==========================================

// MARKETPLACE stores sell provider products (and custom products) with the
// platform commission + transfers model. INDEPENDENT stores sell only the
// creator's own products, charge directly on the creator's Standard Stripe
// account, and pay no platform commission.
enum StoreType {
  MARKETPLACE
  INDEPENDENT
}

model Store {
  id                   String   @id @default(uuid())
  creator_id           String   @unique
  slug                 String   @unique
  custom_domain        String?  @unique
  name                 String
  description          String?
  logo_url             String?
  favicon_url          String?
  store_type           StoreType @default(MARKETPLACE)
  // Presentment currency for this store. Null means "inherit the platform
  // default". Only INDEPENDENT stores may set it: they charge directly on the
  // creator's own connected account, so the currency is theirs to choose.
  // Marketplace orders are charged on the platform account and split with
  // transfers, so they stay on the platform currency.
  currency             String?   @db.VarChar(3)
  theme_key            String   @default("minimal")
  theme_customizations Json     @default("{}")
  theme_config         Json     @default("{}")
  is_active            Boolean  @default(true)
  // When false, the storefront serves this store uncached (always fresh).
  cache_enabled        Boolean  @default(true)
  // Cash on delivery is opt-in per store (off by default).
  cod_enabled          Boolean   @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  creator         Creator  @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  language_config StoreLanguageConfig?
  static_pages    StaticPage[]
  pages           Page[]
  menus           Menu[]
  mail_settings   StoreMailSettings?
  mail_templates  StoreNotificationTemplate[]

  @@index([slug])
}

// Own SMTP sender for an INDEPENDENT store, so its customers receive mail from
// the creator's own domain instead of the platform's. Absent, disabled or
// incomplete means "use the platform sender". The password is encrypted at
// rest with the same envelope as the platform SMTP and the Stripe secrets.
model StoreMailSettings {
  id          String    @id @default(uuid())
  store_id    String    @unique
  smtp_host   String?
  smtp_port   Int?
  smtp_secure Boolean   @default(false)
  smtp_user   String?
  smtp_pass   String?
  mail_from   String?
  enabled     Boolean   @default(false)
  // Last time a test message went out successfully — surfaced in the dashboard
  // so a creator can tell a saved config from a working one.
  verified_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

// Per-store override of a transactional email template. Same per-locale JSON
// shape as NotificationTemplate so both go through one render path; a missing
// row simply falls through to the platform template.
model StoreNotificationTemplate {
  id         String   @id @default(uuid())
  store_id   String
  event      String
  subject    Json     @default("{}")
  body_html  Json     @default("{}")
  body_text  Json     @default("{}")
  enabled    Boolean  @default(true)
  updated_at DateTime @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, event])
  @@index([store_id])
}

model StoreLanguageConfig {
  id                String   @id @default(uuid())
  store_id          String   @unique
  primary_locale    String   @default("en") @db.VarChar(5)
  secondary_locales String[]
  auto_translate    Boolean  @default(false)
  fallback_locale   String   @default("en") @db.VarChar(5)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model StaticPage {
  id          String         @id @default(uuid())
  store_id    String
  type        StaticPageType
  slug        String
  is_required Boolean        @default(false)
  sort_order  Int            @default(0)
  status      PageStatus     @default(DRAFT)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  store        Store                   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  translations StaticPageTranslation[]
  blocks       PageBlock[]

  @@unique([store_id, slug])
}

enum StaticPageType {
  ABOUT
  CONTACT
  PRIVACY_POLICY
  TERMS
  SHIPPING_POLICY
  RETURN_POLICY
  FAQ
  CUSTOM
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model StaticPageTranslation {
  id      String @id @default(uuid())
  page_id String
  locale  String @db.VarChar(5)
  title   String
  content String?

  page StaticPage @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, locale])
}

// ==========================================
// 13b. Page Builder Blocks
// ==========================================

model PageBlock {
  id         String    @id @default(uuid())
  page_id    String
  type       BlockType
  settings   Json      @default("{}") // { layout, colors, spacing }
  sort_order Int       @default(0)
  created_at DateTime  @default(now())

  page         StaticPage             @relation(fields: [page_id], references: [id], onDelete: Cascade)
  translations PageBlockTranslation[]

  @@index([page_id])
}

enum BlockType {
  HERO
  TEXT
  IMAGE
  GALLERY
  VIDEO
  BEFORE_AFTER
  FAQ
  REVIEWS
  CTA
  CUSTOM_HTML
  SPACER
}

model PageBlockTranslation {
  id       String @id @default(uuid())
  block_id String
  locale   String @db.VarChar(5)
  content  Json   // block content varies by type

  block PageBlock @relation(fields: [block_id], references: [id], onDelete: Cascade)

  @@unique([block_id, locale])
}

// ==========================================
// 13c. Page Builder v2 — themed, versioned, multi-type pages
// ==========================================
// Runs alongside StaticPage/PageBlock during the migration period. Storefront
// and dashboard consume Page/PageSection going forward; StaticPage rows are
// lazily mirrored when the creator opens the v2 builder.

model Page {
  id                   String          @id @default(uuid())
  store_id             String
  type                 PageType
  static_kind          StaticPageType? // populated only when type=STATIC
  slug                 String?         // null for HOME (one per store)
  is_required          Boolean         @default(false)
  sort_order           Int             @default(0)
  status               PageStatus      @default(DRAFT)
  seo                  Json            @default("{}") // { og_image, canonical, robots, twitter_card, jsonld_overrides }
  published_version_id String?         @unique
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  store             Store              @relation(fields: [store_id], references: [id], onDelete: Cascade)
  translations      PageTranslation[]
  sections          PageSection[]      // live working draft
  versions          PageVersion[]      @relation("PageVersionHistory")
  published_version PageVersion?       @relation("PagePublishedVersion", fields: [published_version_id], references: [id])

  @@unique([store_id, slug])
  @@unique([store_id, type, static_kind])
  @@index([store_id, type, status])
}

enum PageType {
  HOME
  STATIC
  LANDING
  PRODUCT_TEMPLATE
  // Singleton chrome pages. One HEADER and one FOOTER per store, no slug,
  // never deletable. Storefront renders their published sections globally
  // across every storefront page via StoreLayout.
  HEADER
  FOOTER
}

// ── Navigation menus (WordPress-style) ─────────────────────────
// Menus are named, store-scoped collections of items the creator builds
// once, then references from multiple chrome sections (HeaderBar nav,
// FooterColumns, MobileBottomNav, MegaMenu). The `key` is what sections
// store in their settings; renaming or deleting a menu degrades to the
// section's inline fallback rather than breaking the page.

model Menu {
  id         String     @id @default(uuid())
  store_id   String
  key        String     // creator-defined slug, e.g. "main-nav", "footer-shop"
  name       String     // display name shown in the dashboard menu list
  items      MenuItem[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  store      Store      @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, key])
  @@index([store_id])
}

model MenuItem {
  id              String   @id @default(uuid())
  menu_id         String
  // Self-reference for nested items (mega-menu groups, dropdowns). v1
  // editors only expose top-level items; v2 will surface nesting.
  parent_id       String?
  sort_order      Int      @default(0)
  label           String
  // Per-locale label overrides keyed by locale code, e.g. { "ar": "الرئيسية" }.
  // `label` is the primary-locale value + fallback when a locale is missing.
  label_i18n      Json     @default("{}")
  url             String
  open_in_new_tab Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  menu     Menu       @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemNesting", fields: [parent_id], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemNesting")

  @@index([menu_id, parent_id, sort_order])
}

model PageTranslation {
  id               String  @id @default(uuid())
  page_id          String
  locale           String  @db.VarChar(5)
  title            String?
  meta_title       String?
  meta_description String?

  page Page @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, locale])
}

model PageSection {
  id          String   @id @default(uuid())
  page_id     String
  section_key String   // key from the theme registry (e.g. 'hero-banner')
  settings    Json     @default("{}")
  sort_order  Int      @default(0)
  is_hidden   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  page         Page                      @relation(fields: [page_id], references: [id], onDelete: Cascade)
  translations PageSectionTranslation[]

  @@index([page_id, sort_order])
}

model PageSectionTranslation {
  id         String @id @default(uuid())
  section_id String
  locale     String @db.VarChar(5)
  content    Json   @default("{}")

  section PageSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, locale])
}

// Frozen snapshot of a page (sections + per-locale section content + page
// translations + seo) at publish or save-as-draft time.
model PageVersion {
  id           String    @id @default(uuid())
  page_id      String
  label        String?
  snapshot     Json
  published_at DateTime?
  created_at   DateTime  @default(now())

  page                Page    @relation("PageVersionHistory", fields: [page_id], references: [id], onDelete: Cascade)
  published_for_pages Page[]  @relation("PagePublishedVersion")

  @@index([page_id, published_at])
}

// ==========================================
// 15. Custom Products
// ==========================================

model CustomProduct {
  id               String        @id @default(uuid())
  product_id       String
  creator_id       String
  import_mode      ImportMode    @default(CUSTOMIZE)
  pricing_type     PricingType   @default(SINGLE)
  final_price      Decimal       @default(0) @db.Decimal(10, 2)
  margin_amount    Decimal?      @db.Decimal(10, 2)
  status           ProductStatus @default(DRAFT)
  rejection_reason String?
  submitted_at     DateTime?
  reviewed_at      DateTime?
  reviewed_by      String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  product            Product                        @relation(fields: [product_id], references: [id])
  creator            Creator                        @relation(fields: [creator_id], references: [id])
  mockup_images      CustomProductImage[]
  translations       CustomProductTranslation[]
  selected_variants  CustomProductVariant[]
  field_values       CustomProductFieldValue[]
  faqs               CustomProductFaq[]
  order_items        OrderItem[]
  bundles            BundleCustomProduct[]
  creator_categories CustomProductCreatorCategory[]
}

model CustomProductCreatorCategory {
  custom_product_id   String
  creator_category_id String
  sort_order          Int    @default(0)

  custom_product   CustomProduct   @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)
  creator_category CreatorCategory @relation(fields: [creator_category_id], references: [id], onDelete: Cascade)

  @@id([custom_product_id, creator_category_id])
  @@index([creator_category_id])
}

model CustomProductImage {
  id                String @id @default(uuid())
  custom_product_id String
  url               String
  sort_order        Int    @default(0)

  custom_product CustomProduct @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)
}

model CustomProductTranslation {
  id                String @id @default(uuid())
  custom_product_id String
  locale            String @db.VarChar(5)
  title             String
  description       String?
  slug              String

  custom_product CustomProduct @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)

  @@unique([custom_product_id, locale])
}

model CustomProductVariant {
  id                String   @id @default(uuid())
  custom_product_id String
  variant_id        String
  custom_price      Decimal? @db.Decimal(10, 2)

  custom_product CustomProduct  @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([custom_product_id, variant_id])
  @@index([custom_product_id])
}

model CustomProductFieldValue {
  id                String  @id @default(uuid())
  custom_product_id String
  custom_field_id   String
  value             String?
  file_url          String?

  custom_product CustomProduct      @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)
  custom_field   ProductCustomField @relation(fields: [custom_field_id], references: [id])

  @@unique([custom_product_id, custom_field_id])
  @@index([custom_product_id])
}

model CustomProductFaq {
  id                String   @id @default(uuid())
  custom_product_id String
  sort_order        Int      @default(0)
  created_at        DateTime @default(now())

  custom_product CustomProduct                @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)
  translations   CustomProductFaqTranslation[]

  @@index([custom_product_id])
}

model CustomProductFaqTranslation {
  id       String @id @default(uuid())
  faq_id   String
  locale   String @db.VarChar(5)
  question String
  answer   String @db.Text

  faq CustomProductFaq @relation(fields: [faq_id], references: [id], onDelete: Cascade)

  @@unique([faq_id, locale])
}

// ==========================================
// 16. Customer Input Fields
// ==========================================

model ProductCustomField {
  id               String          @id @default(uuid())
  product_id       String
  name             String          // internal key: "name_1"
  type             CustomFieldType
  is_required      Boolean         @default(false)
  placeholder      String?
  options          Json?           // for select fields
  validation_rules Json?           // { max_length, pattern, allowed_chars }
  linked_validation Json?          // { type, target_field_id, fill_char }
  sort_order       Int             @default(0)

  product               Product                    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  translations          CustomFieldTranslation[]
  order_values          OrderCustomFieldValue[]
  custom_product_values CustomProductFieldValue[]

  @@index([product_id])
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  IMAGE
  FILE
  SELECT
  COLOR
  FONT
  DATE
  MULTI_IMAGE
}

model CustomFieldTranslation {
  id          String @id @default(uuid())
  field_id    String
  locale      String @db.VarChar(5)
  label       String
  placeholder String?
  option_labels Json?

  field ProductCustomField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([field_id, locale])
}

model OrderCustomFieldValue {
  id              String @id @default(uuid())
  order_item_id   String
  custom_field_id String
  value           String?
  file_url        String?

  order_item   OrderItem          @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  custom_field ProductCustomField @relation(fields: [custom_field_id], references: [id])

  @@index([order_item_id])
}

// ==========================================
// 17. Product FAQ
// ==========================================

model ProductFaq {
  id          String @id @default(uuid())
  product_id  String
  sort_order  Int    @default(0)

  product      Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  translations ProductFaqTranslation[]

  @@index([product_id])
}

model ProductFaqTranslation {
  id       String @id @default(uuid())
  faq_id   String
  locale   String @db.VarChar(5)
  question String
  answer   String

  faq ProductFaq @relation(fields: [faq_id], references: [id], onDelete: Cascade)

  @@unique([faq_id, locale])
}

// ==========================================
// 18. Promotions
// ==========================================

model Promotion {
  id          String          @id @default(uuid())
  provider_id String?
  creator_id  String?
  type        PromotionType
  level       PromotionLevel
  value       Decimal         @db.Decimal(10, 2)
  conditions  Json            @default("{}") // { min_quantity, min_amount, product_ids, category_ids }
  coupon_code String?         @unique
  usage_limit Int?
  usage_count Int             @default(0)
  starts_at   DateTime
  expires_at  DateTime?
  status      PromotionStatus @default(ACTIVE)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  provider     Provider?              @relation(fields: [provider_id], references: [id])
  creator      Creator?               @relation(fields: [creator_id], references: [id])
  translations PromotionTranslation[]
  usages       PromotionUsage[]

  @@index([coupon_code])
  @@index([status])
  @@index([level])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  BUNDLE
  QUANTITY_DISCOUNT
  FREE_SHIPPING
  COUPON
  FLASH_SALE
}

enum PromotionLevel {
  PROVIDER_TO_CREATOR
  CREATOR_TO_CUSTOMER
}

enum PromotionStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

model PromotionTranslation {
  id           String @id @default(uuid())
  promotion_id String
  locale       String @db.VarChar(5)
  title        String
  description  String?

  promotion Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)

  @@unique([promotion_id, locale])
}

model PromotionUsage {
  id              String   @id @default(uuid())
  promotion_id    String
  order_id        String
  user_id         String
  discount_amount Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now())

  promotion Promotion @relation(fields: [promotion_id], references: [id])
  order     Order     @relation(fields: [order_id], references: [id])

  @@index([promotion_id])
  @@index([order_id])
}

// ==========================================
// 18. Notifications
// ==========================================

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String   // ORDER_NEW, ORDER_STATUS, PAYMENT_RECEIVED, etc.
  title      String
  body       String
  data       Json?    // { order_id, product_id, etc. }
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id, is_read])
  @@index([user_id, created_at])
}

// ==========================================
// 19. Bundles (LightFunnels-style upsell offers)
// ==========================================

model Bundle {
  id         String       @id @default(uuid())
  creator_id String
  status     BundleStatus @default(ACTIVE)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  creator         Creator               @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  translations    BundleTranslation[]
  offers          BundleOffer[]
  products        BundleProduct[]
  custom_products BundleCustomProduct[]

  @@index([creator_id])
}

model BundleTranslation {
  id        String @id @default(uuid())
  bundle_id String
  locale    String @db.VarChar(5)
  name      String

  bundle Bundle @relation(fields: [bundle_id], references: [id], onDelete: Cascade)

  @@unique([bundle_id, locale])
}

model BundleOffer {
  id             String             @id @default(uuid())
  bundle_id      String
  quantity       Int
  discount_type  BundleDiscountType
  discount_value Decimal            @db.Decimal(10, 2)
  external_ref   String?
  sort_order     Int                @default(0)

  bundle       Bundle                   @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  translations BundleOfferTranslation[]
  cart_items   CartItem[]
  order_items  OrderItem[]

  @@index([bundle_id])
}

model BundleOfferTranslation {
  id           String  @id @default(uuid())
  offer_id     String
  locale       String  @db.VarChar(5)
  title        String
  label        String?
  sticker_text String?

  offer BundleOffer @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  @@unique([offer_id, locale])
}

model BundleProduct {
  bundle_id  String
  product_id String

  bundle  Bundle  @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([bundle_id, product_id])
  @@index([product_id])
}

model BundleCustomProduct {
  bundle_id         String
  custom_product_id String

  bundle         Bundle        @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  custom_product CustomProduct @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)

  @@id([bundle_id, custom_product_id])
  @@index([custom_product_id])
}

enum BundleDiscountType {
  ITEM
  PERCENTAGE
  FIXED
}

enum BundleStatus {
  ACTIVE
  DISABLED
}
