model BundleOffer {
  id             String             @id @default(uuid())
  bundle_id      String
  quantity       Int
  discount_type  BundleDiscountType
  discount_value Decimal            @db.Decimal(10, 2)
  external_ref   String?
  sort_order     Int                @default(0)

  bundle       Bundle                   @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
