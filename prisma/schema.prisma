// ==========================================
// 16. Customer Input Fields
// ==========================================

model ProductCustomField {
  id                String          @id @default(uuid())
  product_id        String
  name              String // internal key: "name_1"
  type              CustomFieldType
  is_required       Boolean         @default(false)
  placeholder       String?
  options           Json? // for select fields
  validation_rules  Json? // { max_length, pattern, allowed_chars }
  linked_validation Json? // { type, target (field name), fill_char?, max? }; legacy target_field_id still read
  sort_order        Int             @default(0)
  // Personalization app (M4.1). All null for fields written without the app.
  parent_id         String? // REPEATER child -> parent; null = top level
  conditions        Json? // PConditions
  pricing           Json? // PPricing
  repeat            Json? // PRepeat (REPEATER only)
  ui                Json? // PUi
  preset_key        String?         @db.VarChar(48) // preset that created the field
  preset_ref        String?         @db.VarChar(191) // importer external ref (M4.4)

  product               Product                   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  parent                ProductCustomField?       @relation("CustomFieldChildren", fields: [parent_id], references: [id], onDelete: Cascade)
  children              ProductCustomField[]      @relation("CustomFieldChildren")
  translations          CustomFieldTranslation[]
  order_values          OrderCustomFieldValue[]
  custom_product_values CustomProductFieldValue[]

  @@index([product_id])
  @@index([parent_id])
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  IMAGE
  FILE
  SELECT
  COLOR
  FONT
  DATE
  MULTI_IMAGE
  // Personalization app (M4.1) only.
  CHECKBOX_GROUP
  COLOR_PALETTE
  REPEATER
}

model CustomFieldTranslation {
  id             String  @id @default(uuid())
  field_id       String
  locale         String  @db.VarChar(5)
  label          String
  placeholder    String?
  option_labels  Json?
  // Personalization app (M4.1). All null without the app.
  display_label  String? // cart/order/email label when the form label differs
  sublabel       String? // line above the input
  note           String? // line below the input
  help_text      String? // help modal body, newline separated
  help_image_url String?
  messages       Json? // { required?, pattern?, allowed_chars?, equal_length?, max_length?, min_checked?, max_checked? }

  field ProductCustomField @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@unique([field_id, locale])
}

model OrderCustomFieldValue {
  id              String           @id @default(uuid())
  order_item_id   String
  // M4.0: nullable, SET NULL when the field is deleted; the snapshot columns
  // below keep the order history readable.
  custom_field_id String?
  value           String?
  file_url        String?
  // M4.0 snapshot of the field at order time.
  field_name      String? // ProductCustomField.name
  field_type      CustomFieldType?
  field_label     Json? // { "<locale>": "<label>" }
  display_value   Json? // { "<locale>": "<option label>" } (SELECT/FONT)
  sort_order      Int?
  // M4.0 WP-B: private original behind a customer file value.
  upload_id       String?
  // Personalization app (M4.1) grouping/pricing snapshot. M4.0's sort_order
  // is reused (no own column). Defaults keep rows without the app unchanged.
  group_key       String?          @db.VarChar(64) // repeater name
  group_index     Int? // 1..N ("Artikel i")
  group_label     Json? // { "<locale>": "Artikel 2" }
  source          String           @default("FIELD") @db.VarChar(8) // FIELD | OPTION | DESIGN
  price_delta     Decimal          @default(0) @db.Decimal(10, 2) // per unit, order currency
  meta            Json? // { hex?, option_name? }

  order_item   OrderItem           @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  custom_field ProductCustomField? @relation(fields: [custom_field_id], references: [id], onDelete: SetNull)
  upload       CustomerUpload?     @relation(fields: [upload_id], references: [id], onDelete: SetNull)

  @@index([order_item_id])
  @@index([custom_field_id])
  @@index([upload_id])
}

// M4.0: a storefront customer's uploaded file. The exact original bytes live
// in private storage (`original_key`); the public preview URL is the value
// stored in the cart and order. store_id has no foreign key on purpose (set on
// first attach, kept after the store is gone, like Order.store_id).
model CustomerUpload {
  id            String    @id @default(uuid())
  store_id      String?
  original_key  String
  original_name String    @db.VarChar(255)
  mime          String    @db.VarChar(100)
  bytes         Int
  width         Int?
  height        Int?
  sha256        String    @db.Char(64)
  preview_url   String
  created_at    DateTime  @default(now())
  attached_at   DateTime?
  purged_at     DateTime?

  values OrderCustomFieldValue[]

  @@index([attached_at])
  @@index([created_at])
  @@index([store_id])
}

// Personalization app (M4.1): store-scoped library of reusable field
// definitions ({ field, children } without ids).
model PersonalizationFieldTemplate {
  id         String   @id @default(uuid())
  store_id   String
  name       String   @db.VarChar(120)
  definition Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
}

// ==========================================
// 16b. Production checklist (M4.3 production app)
// ==========================================

enum ProductionCheckSource {
  FIELD_VALUE
  VARIANT_OPTION
  DESIGN
  CUSTOM
}

enum ProductionState {
  NONE
  NOT_STARTED
  IN_PROGRESS
  READY
}

// One check per thing to produce on an order line. Rows exist only for
// stores with the production app (nothing is backfilled for others).
model OrderProductionCheck {
  id            String                @id @default(uuid())
  store_id      String // denormalised scope, no FK (like Invoice.store_id)
  order_id      String
  order_item_id String
  source        ProductionCheckSource
  // Stable key, unique per line: fv:<OrderCustomFieldValue.id> |
  // opt:<option name> | design:<OrderItemDesign.id> | custom:<uuid>
  source_key    String                @db.VarChar(160)
  source_hash   String?               @db.VarChar(64) // sha256(label|value|file_url)
  label         String // snapshot (store primary locale)
  value         String? // snapshot display value
  group_index   Int? // repeater instance ("Artikel i")
  file_url      String? // image/file value (thumbnail)
  sort_order    Int                   @default(0)
  done          Boolean               @default(false)
  done_at       DateTime?
  done_by       String? // User.id (no relation)
  done_by_name  String?
  stale         Boolean               @default(false) // source vanished; excluded from progress
  created_by    String? // custom items
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt

  order      Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_item OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)

  @@unique([order_item_id, source_key])
  @@index([order_id])
  @@index([store_id])
}

// Denormalised per-order progress so the orders list can filter server-side.
model OrderProductionSummary {
  order_id             String          @id
  store_id             String
  total                Int             @default(0) // non-stale checks
  done                 Int             @default(0)
  state                ProductionState @default(NONE)
  completed_at         DateTime?
  // Set when the on-complete auto-advance (QUALITY_CHECK) could not run or
  // failed; the next write / workspace read of the order retries it.
  auto_advance_pending Boolean         @default(false)
  synced_at            DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([store_id, state])
}

// Append-only production audit trail. Not customer-visible.
model OrderProductionEvent {
  id         String   @id @default(uuid())
  order_id   String
  check_id   String? // no FK: survives custom-item deletion
  action     String   @db.VarChar(24) // CHECK|UNCHECK|ADD|REMOVE|BULK|VALUE_CHANGED|STALE|COMPLETED|AUTO_ADVANCE
  actor_id   String?
  actor_name String?
  payload    Json?
  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at])
}

// ==========================================
// 17. Product FAQ
