model Promotion {
  id          String          @id @default(uuid())
  provider_id String?
  creator_id  String?
  type        PromotionType
  level       PromotionLevel
  value       Decimal         @db.Decimal(10, 2)
  conditions  Json            @default("{}") // { min_quantity, min_amount, product_ids, category_ids }
  coupon_code String?         @unique
  usage_limit Int?
  usage_count Int             @default(0)
  starts_at   DateTime
  expires_at  DateTime?
