generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. المستخدمون والمصادقة
// ==========================================

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password_hash String
  role          UserRole
  status        UserStatus @default(PENDING)
  avatar_url    String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  provider Provider?
  creator  Creator?
  customer Customer?
  sessions Session[]

  @@index([email])
  @@index([role, status])
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}

enum UserRole {
  ADMIN
  PROVIDER
  CREATOR
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

// ==========================================
// 2. Provider (المزود)
// ==========================================

model Provider {
  id                             String    @id @default(uuid())
  user_id                        String    @unique
  company_name                   String
  description                    String?
  logo_url                       String?
  phone                          String?
  country                        String
  stripe_account_id              String?
  // Stripe Connect onboarding state, kept in sync via the account.updated webhook.
  stripe_charges_enabled         Boolean   @default(false)
  stripe_payouts_enabled         Boolean   @default(false)
  stripe_onboarding_completed_at DateTime?
  verified                       Boolean   @default(false)
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  products          Product[]
  promotions        Promotion[]
  shipping_profiles ShippingProfile[]
}

// ==========================================
// 3. Creator (المبدع)
// ==========================================

model Creator {
  id                             String    @id @default(uuid())
  user_id                        String    @unique
  display_name                   String
  bio                            String?
  avatar_url                     String?
  cover_url                      String?
  phone                          String?
  stripe_account_id              String?
  // Connected account type: 'express' (marketplace transfers model) or
  // 'standard' (independent stores charging directly on their own account).
  stripe_account_type            String?
  // Stripe Connect onboarding state, kept in sync via the account.updated webhook.
  stripe_charges_enabled         Boolean   @default(false)
  stripe_payouts_enabled         Boolean   @default(false)
  stripe_onboarding_completed_at DateTime?
  // Kustom Checkout (independent stores only). The creator holds their own
  // Kustom merchant account; the shared secret is encrypted at rest.
  kustom_merchant_id             String?
  kustom_shared_secret           String?
  kustom_environment             String    @default("playground") // 'playground' | 'production'
  kustom_enabled                 Boolean   @default(false)
  // When the authorization is captured: 'on_shipment' (Klarna's default model,
  // captured when the order ships or manually) or 'immediate' (captured as
  // soon as the purchase is confirmed).
  kustom_capture_mode            String    @default("on_shipment")
  verified                       Boolean   @default(false)
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  user               User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  own_products       Product[]
  store              Store?
  custom_products    CustomProduct[]
  promotions         Promotion[]
  bundles            Bundle[]
  creator_categories CreatorCategory[]
  shipping_profiles  ShippingProfile[]
}

// ==========================================
// 4. Customer (العميل)
// ==========================================

model Customer {
  id            String     @id @default(uuid())
  user_id       String     @unique
  first_name    String
  last_name     String
  phone         String?
  // b2b app: default buyer type and company identity used to prefill
  // checkout. Null = person / never set.
  customer_type BuyerType?
  company_name  String?
  org_number    String?    @db.VarChar(32)
  vat_number    String?    @db.VarChar(32)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  user           User                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  addresses      Address[]
  orders         Order[]
  cart           Cart?
  tax_exemptions StoreCustomerTaxExemption[]
}

model Address {
  id              String   @id @default(uuid())
  customer_id     String
  label           String?
  full_name       String
  line1           String
  line2           String?
  city            String
  state           String?
  postal_code     String
  country_code    String   @db.VarChar(2)
  phone           String?
  // b2b app: company fields of this (billing) address.
  company_name    String?
  org_number      String?  @db.VarChar(32)
  buyer_reference String?
  is_default      Boolean  @default(false)
  created_at      DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customer_id])
}

// ==========================================
// 5. الفئات (Categories)
// ==========================================

model Category {
  id         String  @id @default(uuid())
  parent_id  String?
  slug       String  @unique
  icon       String?
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  parent              Category?                   @relation("CategoryTree", fields: [parent_id], references: [id])
  children            Category[]                  @relation("CategoryTree")
  translations        CategoryTranslation[]
  attribute_templates CategoryAttributeTemplate[]
  products            Product[]
}

model CategoryTranslation {
  id          String  @id @default(uuid())
  category_id String
  locale      String  @db.VarChar(5)
  name        String
  description String?

  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, locale])
}

// ==========================================
// 5b. تصنيفات الكرييتور (Creator Collections)
// ==========================================
// Creator-scoped grouping of products (Shopify-style Collections), independent
// of the admin-managed global Category taxonomy. A creator can nest these into
// sub-collections via parent_id and include products either manually or by tag.

enum CreatorCategoryMatchRule {
  MANUAL
  TAGS
}

model CreatorCategory {
  id                 String                   @id @default(uuid())
  creator_id         String
  parent_id          String?
  slug               String
  thumbnail_url      String?
  match_rule         CreatorCategoryMatchRule @default(MANUAL)
  match_tags         String[]
  sort_order         Int                      @default(0)
  is_active          Boolean                  @default(true)
  // Importer identity "woo:<site_host>:product_cat:<id>" (M4.4); null = not imported.
  external_ref       String?                  @db.VarChar(191)
  // Leave the collection out of the sitemap / noindex it while it has no published products.
  noindex_when_empty Boolean                  @default(false)
  created_at         DateTime                 @default(now())
  updated_at         DateTime                 @updatedAt

  creator         Creator                        @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  parent          CreatorCategory?               @relation("CreatorCategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children        CreatorCategory[]              @relation("CreatorCategoryTree")
  translations    CreatorCategoryTranslation[]
  products        ProductCreatorCategory[]
  custom_products CustomProductCreatorCategory[]

  @@unique([creator_id, slug])
  @@unique([creator_id, external_ref])
  @@index([creator_id, parent_id])
}

model CreatorCategoryTranslation {
  id                  String  @id @default(uuid())
  creator_category_id String
  locale              String  @db.VarChar(5)
  name                String
  description         String?
  meta_title          String?
  meta_desc           String?

  creator_category CreatorCategory @relation(fields: [creator_category_id], references: [id], onDelete: Cascade)

  @@unique([creator_category_id, locale])
}

model ProductCreatorCategory {
  product_id          String
  creator_category_id String
  sort_order          Int    @default(0)

  product          Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  creator_category CreatorCategory @relation(fields: [creator_category_id], references: [id], onDelete: Cascade)

  @@id([product_id, creator_category_id])
  @@index([creator_category_id])
}

// ==========================================
// 6. قوالب المواصفات (Attribute Templates)
// ==========================================

model AttributeTemplate {
  id               String        @id @default(uuid())
  name             String // مفتاح داخلي: "fabric", "wood_type"
  type             AttributeType
  unit             String? // "cm", "mm", "gsm"
  options          Json? // ["cotton", "polyester"]
  is_required      Boolean       @default(false)
  group_name       String? // "المادة", "الأبعاد"
  validation_rules Json? // { min, max, pattern }
  sort_order       Int           @default(0)

  translations AttributeTemplateTranslation[]
  categories   CategoryAttributeTemplate[]
  values       ProductAttribute[]
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  BOOLEAN
  COLOR
  DIMENSIONS
}

model AttributeTemplateTranslation {
  id            String @id @default(uuid())
  template_id   String
  locale        String @db.VarChar(5)
  label         String // "نوع القماش"
  option_labels Json? // {"cotton": "قطن"}

  template AttributeTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, locale])
}

model CategoryAttributeTemplate {
  category_id String
  template_id String

  category Category          @relation(fields: [category_id], references: [id], onDelete: Cascade)
  template AttributeTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@id([category_id, template_id])
}

// ==========================================
// 7. المنتجات (Products)
// ==========================================

model Product {
  id                    String             @id @default(uuid())
  provider_id           String?
  creator_id            String?
  category_id           String
  product_type          ProductType
  customization_type    CustomizationType?
  base_price            Decimal            @db.Decimal(10, 2)
  compare_at_price      Decimal?           @db.Decimal(10, 2)
  cost_price            Decimal?           @db.Decimal(10, 2)
  sku                   String?
  track_inventory       Boolean            @default(false)
  stock_quantity        Int?
  weight                Decimal?           @db.Decimal(8, 2)
  weight_unit           String?            @default("kg")
  variant_option_config Json?
  shipping_profile_id   String?
  // Tax class of the product (platform or the owning store's own class);
  // null = the default class of the scope. tax_exempt short-circuits every
  // rate lookup to 0 %.
  tax_class_id          String?
  tax_exempt            Boolean            @default(false)
  status                ProductStatus      @default(DRAFT)
  is_featured           Boolean            @default(false)
  // Importer identity "woo:<site_host>:product:<id>" (M4.4); never copied by duplicate().
  external_ref          String?            @db.VarChar(191)
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  provider           Provider?                @relation(fields: [provider_id], references: [id])
  tax_class          TaxClass?                @relation(fields: [tax_class_id], references: [id], onDelete: SetNull)
  creator            Creator?                 @relation(fields: [creator_id], references: [id])
  category           Category                 @relation(fields: [category_id], references: [id])
  shipping_profile   ShippingProfile?         @relation(fields: [shipping_profile_id], references: [id], onDelete: SetNull)
  translations       ProductTranslation[]
  images             ProductImage[]
  attributes         ProductAttribute[]
  variants           ProductVariant[]
  tags               ProductTag[]
  custom_fields      ProductCustomField[]
  faqs               ProductFaq[]
  custom_products    CustomProduct[]
  order_items        OrderItem[]
  bundles            BundleProduct[]
  creator_categories ProductCreatorCategory[]
  market_prices      ProductMarketPrice[]
  designer           ProductDesigner?

  @@unique([creator_id, external_ref])
  @@index([provider_id])
  @@index([creator_id])
  @@index([category_id])
  @@index([status])
  @@index([product_type])
}

enum ProductType {
  TRADITIONAL
  CUSTOMIZABLE
}

enum CustomizationType {
  PRINT
  ENGRAVE
  PRINT_3D
  EMBROIDERY
  HANDMADE
  HEAT_PRESS
  SCREEN_PRINT
  UV_PRINT
  CNC
  OTHER
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum ImportMode {
  AS_IS
  CUSTOMIZE
}

enum PricingType {
  SINGLE
  PER_VARIANT
  MARGIN
}

model ProductTranslation {
  id                String  @id @default(uuid())
  product_id        String
  locale            String  @db.VarChar(5)
  title             String
  description       String
  slug              String
  meta_title        String?
  meta_desc         String?
  // Short HTML summary shown above add-to-cart (M4.4); null for most products.
  short_description String?

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, locale])
  @@index([slug])
}

model ProductImage {
  id          String  @id @default(uuid())
  product_id  String
  variant_id  String?
  url         String
  alt_text    String?
  sort_order  Int     @default(0)
  is_featured Boolean @default(false)

  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id])
}

model ProductAttribute {
  id          String @id @default(uuid())
  product_id  String
  template_id String
  value       Json

  product  Product           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  template AttributeTemplate @relation(fields: [template_id], references: [id])

  @@unique([product_id, template_id])
}

model ProductTag {
  id         String @id @default(uuid())
  product_id String
  tag        String

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([tag])
}

// ==========================================
// 8. المتغيرات (Variants)
// ==========================================

model ProductVariant {
  id               String   @id @default(uuid())
  product_id       String
  sku              String?  @unique
  price_adjustment Decimal  @default(0) @db.Decimal(10, 2)
  compare_at_price Decimal? @db.Decimal(10, 2)
  stock_quantity   Int?
  is_active        Boolean  @default(true)
  options          Json // { "size": "L", "color": "black" }
  // Importer identity "woo:<site_host>:variation:<id>" (M4.4).
  external_ref     String?  @db.VarChar(191)

  product                 Product                @relation(fields: [product_id], references: [id], onDelete: Cascade)
  images                  ProductImage[]
  order_items             OrderItem[]
  custom_product_variants CustomProductVariant[]
  market_prices           ProductMarketPrice[]

  @@unique([product_id, external_ref])
  @@index([product_id])
}

// ==========================================
// 9. الشحن (Shipping)
// ==========================================

model ShippingProfile {
  id          String   @id @default(uuid())
  provider_id String?
  creator_id  String?
  name        String
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())

  // Owner: exactly one of provider / creator. Deleting the owner removes
  // their profiles (zones / methods cascade from the profile; products fall
  // back to null via Product.shipping_profile_id ON DELETE SET NULL).
  provider Provider?      @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  creator  Creator?       @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  zones    ShippingZone[]
  products Product[]

  @@index([provider_id])
  @@index([creator_id])
}

model ShippingZone {
  id                 String   @id @default(uuid())
  profile_id         String
  name               String
  countries          String[]
  base_cost          Decimal  @db.Decimal(10, 2)
  per_item_cost      Decimal  @default(0) @db.Decimal(10, 2)
  free_threshold     Decimal? @db.Decimal(10, 2)
  estimated_days_min Int
  estimated_days_max Int

  profile ShippingProfile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  // Selectable methods offered for this zone. The cost/days columns above are
  // the legacy single method: they were copied into one "Standard shipping"
  // method on migration and remain the fallback for a zone with no methods.
  methods ShippingMethod[]
}

enum ShippingMethodType {
  DELIVERY
  PICKUP
}

// One shipping option the customer can pick for a zone (e.g. "Standard
// shipping", "Express", "Pick up in store"). Priced base + per_item * count,
// free at or above free_threshold.
model ShippingMethod {
  id                 String             @id @default(uuid())
  zone_id            String
  // Default display name; `translations` holds per-locale overrides keyed by
  // locale code, e.g. { "sv": "Standardfrakt" }.
  name               String
  translations       Json?
  type               ShippingMethodType @default(DELIVERY)
  base_cost          Decimal            @db.Decimal(10, 2)
  per_item_cost      Decimal            @default(0) @db.Decimal(10, 2)
  free_threshold     Decimal?           @db.Decimal(10, 2)
  estimated_days_min Int
  estimated_days_max Int
  is_active          Boolean            @default(true)
  sort_order         Int                @default(0)
  created_at         DateTime           @default(now())

  zone ShippingZone @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@index([zone_id])
}

// ==========================================
// 10. السلة (Cart)
// ==========================================

model Cart {
  id          String   @id @default(uuid())
  customer_id String   @unique
  store_id    String?
  updated_at  DateTime @updatedAt

  customer Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id                String  @id @default(uuid())
  cart_id           String
  product_id        String?
  variant_id        String?
  custom_product_id String?
  bundle_offer_id   String?
  quantity          Int     @default(1)
  custom_fields     Json?
  // Designer app (M4.2): the customer design of the line. No FK, so a purged
  // draft never cascades into cart rows (retention deletes those lines).
  design_id         String?

  cart         Cart         @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  bundle_offer BundleOffer? @relation(fields: [bundle_offer_id], references: [id], onDelete: SetNull)

  @@index([cart_id])
  @@index([bundle_offer_id])
  @@index([design_id])
}

// ==========================================
// 11. الطلبات (Orders)
// ==========================================

model Order {
  id                      String              @id @default(uuid())
  order_number            String              @unique
  customer_id             String
  address_id              String
  store_id                String?
  status                  OrderStatus         @default(PENDING)
  subtotal                Decimal             @db.Decimal(10, 2)
  shipping_cost           Decimal             @default(0) @db.Decimal(10, 2)
  discount_amount         Decimal             @default(0) @db.Decimal(10, 2)
  total                   Decimal             @db.Decimal(10, 2)
  currency                String              @default("EUR") @db.VarChar(3)
  payment_method          PaymentMethod       @default(COD)
  payment_status          String?
  stripe_payment_id       String?
  // Snapshot of the connected account a direct-charge PaymentIntent was created
  // on (independent stores). Null = the payment was charged on the platform.
  stripe_account_id       String?
  // Stripe payment details captured from the webhook for tracking/reconciliation.
  stripe_charge_id        String?
  card_brand              String?
  card_last4              String?             @db.VarChar(4)
  receipt_url             String?
  paid_at                 DateTime?
  payment_failure_code    String?
  payment_failure_message String?
  // Kustom Checkout: the checkout/order id on Kustom's side, the random secret
  // embedded in the push/validation callback URLs (never exposed to the
  // customer), and the capture bookkeeping (captured when the order ships).
  kustom_order_id         String?             @unique
  kustom_push_token       String?
  kustom_capture_id       String?
  kustom_captured_at      DateTime?
  // Tax snapshot. tax_rate_bp is the headline rate (highest rate on the
  // order, basis points) and tax_amount the tax total — both kept for
  // compatibility; the itemized breakdown is tax_lines (TaxLine[]: label,
  // rate_bp, taxable_amount, tax_amount in major units). In INCLUSIVE mode
  // the tax is part of `total`, in EXCLUSIVE mode it was added on top.
  tax_rate_bp             Int                 @default(0)
  tax_amount              Decimal             @default(0) @db.Decimal(10, 2)
  tax_pricing_mode        TaxPricingMode      @default(INCLUSIVE)
  tax_basis_country       String?             @db.VarChar(2)
  tax_lines               Json?
  // Tax on the shipping line, kept apart so a payment mapper can stamp the
  // shipping fee with its own rate without re-deriving it from tax_lines.
  shipping_tax_rate_bp    Int                 @default(0)
  shipping_tax_amount     Decimal             @default(0) @db.Decimal(10, 2)
  // Snapshot of the shipping method the customer chose: the ShippingMethod id
  // (no FK — methods may be deleted later), its display name in the store's
  // primary locale (e.g. "Standard shipping") and its type. All null for
  // orders placed before methods were modelled or with no shipping profile.
  shipping_method_id      String?
  shipping_method_name    String?
  shipping_method_type    ShippingMethodType?
  // Markets app: the market the order was placed in, the storefront host it
  // was placed on, the UI locale and the base->market rate the prices were
  // converted with (1 when the market prices in the store currency). All
  // null for orders placed without the app.
  market_id               String?
  hostname                String?
  locale                  String?             @db.VarChar(10)
  fx_rate_snapshot        Decimal?            @db.Decimal(18, 8)
  // b2b app snapshot. All null for orders placed as a person / without the
  // app. Net/gross are derived (see deriveNetTotals), never stored.
  customer_type           BuyerType?
  company_name            String?
  org_number              String?             @db.VarChar(32)
  vat_number              String?             @db.VarChar(32)
  buyer_reference         String?
  // b2b app M2.5: why VAT is zero (null = taxed normally) and the evidence
  // (VIES result / manual exemption, a VatEvidence object).
  tax_exempt_reason       TaxExemptReason?
  vat_validation          Json?
  notes                   String?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  customer           Customer                @relation(fields: [customer_id], references: [id])
  address            Address                 @relation(fields: [address_id], references: [id])
  market             Market?                 @relation(fields: [market_id], references: [id], onDelete: SetNull)
  items              OrderItem[]
  commission         OrderCommission?
  timeline           OrderTimeline[]
  promotion_usage    PromotionUsage[]
  payouts            OrderPayout[]
  invoices           Invoice[]
  // Production app (M4.3): rows exist only for stores with the app.
  production_checks  OrderProductionCheck[]
  production_summary OrderProductionSummary?
  production_events  OrderProductionEvent[]

  @@index([customer_id])
  @@index([order_number])
  @@index([status])
  @@index([market_id])
  @@index([store_id, tax_exempt_reason])
}

// Per-recipient payout (Stripe transfer) for an order — lets each provider /
// creator track what they were paid, and the admin see the full split.
model OrderPayout {
  id                 String        @id @default(uuid())
  order_id           String
  recipient_type     FulfillerType
  recipient_id       String
  stripe_account_id  String?
  stripe_transfer_id String?
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("EUR") @db.VarChar(3)
  status             String        @default("paid")
  error              String?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, recipient_type, recipient_id])
  @@index([recipient_id])
  @@index([order_id])
}

enum PaymentMethod {
  COD
  STRIPE
  KUSTOM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  MANUFACTURING
  QUALITY_CHECK
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
}

model OrderItem {
  id                       String            @id @default(uuid())
  order_id                 String
  product_id               String?
  variant_id               String?
  custom_product_id        String?
  bundle_offer_id          String?
  quantity                 Int
  unit_price               Decimal           @db.Decimal(10, 2)
  original_unit_price      Decimal?          @db.Decimal(10, 2)
  total_price              Decimal           @db.Decimal(10, 2)
  // Unscaled base price owed to this item's provider (0 for creator-only items).
  // Used to split Connect payout transfers per provider after payment succeeds.
  provider_base_amount     Decimal           @default(0) @db.Decimal(10, 2)
  customer_design_url      String?
  design_notes             String?
  fulfiller_type           FulfillerType
  fulfiller_id             String
  fulfillment_status       FulfillmentStatus @default(PENDING)
  tracking_number          String?
  tracking_url             String?
  // Tax snapshot of the line: class key at the time, effective rate (basis
  // points) and the tax amount after the order discount was allocated.
  tax_class_key            String?
  tax_rate_bp              Int               @default(0)
  tax_amount               Decimal           @default(0) @db.Decimal(10, 2)
  // Personalization app (M4.1): per-unit price delta of the line's
  // personalization in the order currency; null = none (always null without
  // the app).
  personalization_amount   Decimal?          @db.Decimal(10, 2)
  // Production app (M4.3): the variant's option map as sold (`{name: value}`),
  // so the checklist never follows a later edit / deletion of the variant.
  // Null on orders placed before the column existed (no backfill).
  variant_options_snapshot Json?

  order               Order                   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product             Product?                @relation(fields: [product_id], references: [id])
  variant             ProductVariant?         @relation(fields: [variant_id], references: [id])
  custom_product      CustomProduct?          @relation(fields: [custom_product_id], references: [id])
  bundle_offer        BundleOffer?            @relation(fields: [bundle_offer_id], references: [id], onDelete: SetNull)
  custom_field_values OrderCustomFieldValue[]
  production_checks   OrderProductionCheck[]
  design              OrderItemDesign?

  @@index([order_id])
  @@index([fulfiller_id])
  @@index([bundle_offer_id])
}

enum FulfillerType {
  PROVIDER
  CREATOR
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  MANUFACTURING
  QUALITY_CHECK
  SHIPPED
  DELIVERED
}

model OrderTimeline {
  id         String   @id @default(uuid())
  order_id   String
  status     String
  note       String?
  actor      String?
  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

// ==========================================
// 12. العمولات (Commissions)
// ==========================================

model OrderCommission {
  id              String           @id @default(uuid())
  order_id        String           @unique
  provider_amount Decimal          @default(0) @db.Decimal(10, 2)
  platform_amount Decimal          @db.Decimal(10, 2)
  creator_amount  Decimal          @default(0) @db.Decimal(10, 2)
  currency        String           @default("EUR") @db.VarChar(3)
  status          CommissionStatus @default(PENDING)
  created_at      DateTime         @default(now())

  order Order @relation(fields: [order_id], references: [id])
}

enum CommissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PlatformConfig {
  id String @id @default(uuid())

  // Commission
  commission_type  String  @default("percentage")
  commission_value Decimal @default(15) @db.Decimal(5, 2)

  // Currency & Locale
  default_currency  String   @default("EUR")
  default_locale    String   @default("en")
  supported_locales String[] @default(["en"])

  // Platform Info
  platform_name String  @default("Multi Stores")
  support_email String?

  // Order Limits
  min_order_amount Decimal? @db.Decimal(10, 2)

  // Legacy platform-wide VAT rate (basis points). Superseded by the TaxRate
  // table (migration 20260923120000 converted it); no longer written.
  default_tax_rate_bp Int @default(0)

  // Platform tax registrant settings: marketplace orders are taxed by the
  // platform, so these decide their pricing mode, registration country and
  // OSS status. tax_rates_seeded_at records the last default-rate seed.
  default_tax_pricing_mode TaxPricingMode @default(INCLUSIVE)
  platform_tax_country     String?        @db.VarChar(2)
  platform_oss_registered  Boolean        @default(false)
  tax_rates_seeded_at      DateTime?

  // Registration Approvals
  require_provider_approval Boolean @default(true)
  require_creator_approval  Boolean @default(true)

  // Platform Stripe account (managed from the admin dashboard). These override
  // the STRIPE_* environment variables when set. Secrets are never returned by
  // the shared platform-config endpoint — only via the admin-only payments API.
  stripe_secret_key             String?
  stripe_publishable_key        String?
  stripe_webhook_secret         String?
  // Signing secret of the Connect (connected accounts) webhook endpoint,
  // used to verify direct-charge events from independent stores.
  stripe_connect_webhook_secret String?

  // Kustom partner id of the platform — sent as the Kustom-Partner header on
  // every Kustom API call made on behalf of a creator. Plain text, optional.
  kustom_partner_id String?

  // Platform SMTP email settings (managed from the admin dashboard). Override
  // the SMTP_*/MAIL_FROM environment variables when set. Credentials are never
  // returned by the shared platform-config endpoint — only via the admin mail API.
  smtp_host   String?
  smtp_port   Int?
  smtp_secure Boolean @default(false)
  smtp_user   String?
  smtp_pass   String?
  mail_from   String?

  // Scheduled database backups (plans/backups/API-CONTRACT.md). Slot = time
  // (HH:mm, server local time) every day, or on backup_weekday when WEEKLY.
  // backup_retention keeps the N most recent SCHEDULED backups on disk.
  backup_enabled         Boolean   @default(false)
  backup_frequency       String    @default("DAILY") // DAILY | WEEKLY
  backup_time            String    @default("03:00") // HH:mm, server local time
  backup_weekday         Int       @default(0) // 0=Sunday … 6, used when WEEKLY
  backup_retention       Int       @default(14) // keep N most recent SCHEDULED backups
  backup_include_uploads Boolean   @default(true)
  backup_last_run_at     DateTime?

  updated_at DateTime @updatedAt
}

// ── Backups ──────────────────────────────────────────────────────────────────
// One row per backup run (manual, scheduled, or the automatic one taken before
// a restore). Files live under BACKUP_DIR and are never served statically;
// db_file / uploads_file hold absolute paths.

enum BackupKind {
  MANUAL
  SCHEDULED
  PRE_RESTORE
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Backup {
  id                 String       @id @default(uuid())
  kind               BackupKind
  status             BackupStatus @default(PENDING)
  db_file            String? // absolute path of the pg_dump custom-format file
  db_size_bytes      BigInt?
  uploads_file       String? // absolute path of the uploads tar.gz
  uploads_size_bytes BigInt?
  includes_uploads   Boolean      @default(false)
  note               String? // free text from the admin
  error              String? // code + stderr tail (<= 2 KB) when FAILED
  created_by         String? // User.id (null for the scheduler)
  started_at         DateTime?
  finished_at        DateTime?
  created_at         DateTime     @default(now())

  @@index([created_at])
}

// Platform-level legal pages (privacy, terms, refund policy, shipping policy).
// Admin-managed; per-locale title + content stored as JSON so a single row
// holds all translations for one slug.
model LegalPage {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      Json     @default("{}") // { en: "Privacy Policy", ar: "سياسة الخصوصية", ... }
  content    Json     @default("{}") // { en: "<html>...</html>", ar: "...", ... }
  updated_at DateTime @updatedAt
}

// Admin-managed transactional notification templates. One row per `event`
// (order_confirmation, password_reset, …). Subject + HTML/text bodies are
// per-locale JSON. `enabled=false` suppresses sending for that event entirely.
// Bodies use `{{var}}` placeholders the MailService substitutes at send time.
model NotificationTemplate {
  id         String   @id @default(uuid())
  event      String   @unique
  subject    Json     @default("{}") // per-locale
  body_html  Json     @default("{}") // per-locale (HTML)
  body_text  Json     @default("{}") // per-locale (plain text)
  enabled    Boolean  @default(true)
  updated_at DateTime @updatedAt
}

// ==========================================
// 13. المتجر (Store)
// ==========================================

// MARKETPLACE stores sell provider products (and custom products) with the
// platform commission + transfers model. INDEPENDENT stores sell only the
// creator's own products, charge directly on the creator's Standard Stripe
// account, and pay no platform commission.
enum StoreType {
  MARKETPLACE
  INDEPENDENT
}

model Store {
  id                      String         @id @default(uuid())
  creator_id              String         @unique
  slug                    String         @unique
  custom_domain           String?        @unique
  name                    String
  description             String?
  logo_url                String?
  favicon_url             String?
  store_type              StoreType      @default(MARKETPLACE)
  // Presentment currency for this store. Null means "inherit the platform
  // default". Only INDEPENDENT stores may set it: they charge directly on the
  // creator's own connected account, so the currency is theirs to choose.
  // Marketplace orders are charged on the platform account and split with
  // transfers, so they stay on the platform currency.
  currency                String?        @db.VarChar(3)
  theme_key               String         @default("minimal")
  theme_customizations    Json           @default("{}")
  theme_config            Json           @default("{}")
  is_active               Boolean        @default(true)
  // When false, the storefront serves this store uncached (always fresh).
  cache_enabled           Boolean        @default(true)
  // Cash on delivery is opt-in per store (off by default).
  cod_enabled             Boolean        @default(false)
  // Marketplace stores only: expose the base product's provider (name/logo)
  // on the storefront as the vendor. Off by default.
  show_vendor_name        Boolean        @default(false)
  // Legacy single VAT override (basis points). Superseded by the TaxRate
  // table (migration 20260923120000 converted it); no longer written.
  tax_rate_bp             Int?
  // Tax settings of an INDEPENDENT store (the store is the tax registrant).
  // MARKETPLACE stores are taxed by the platform and ignore these.
  tax_pricing_mode        TaxPricingMode @default(INCLUSIVE)
  tax_basis               TaxBasis       @default(SHIPPING)
  // Registration country (ISO2); null = the platform's.
  tax_country             String?        @db.VarChar(2)
  oss_registered          Boolean        @default(false)
  // false = only the store's own TaxRate rows apply.
  use_platform_tax_rates  Boolean        @default(true)
  // null = shipping follows the highest-rate class among the order's lines.
  shipping_tax_class_id   String?
  // Catalog display: show prices as tax inclusive.
  display_prices_incl_tax Boolean        @default(true)
  // Where "new order" notifications go. Null = the creator's login email.
  notification_email      String?
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt

  creator                   Creator                        @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  tax_classes               TaxClass[]
  tax_rates                 TaxRate[]
  language_config           StoreLanguageConfig?
  static_pages              StaticPage[]
  pages                     Page[]
  menus                     Menu[]
  mail_settings             StoreMailSettings?
  mail_templates            StoreNotificationTemplate[]
  kustom_sessions           KustomCheckoutSession[]
  apps                      StoreApp[]
  markets                   Market[]
  domains                   StoreDomain[]
  legal_profiles            StoreLegalProfile[]
  tax_exemptions            StoreCustomerTaxExemption[]
  personalization_templates PersonalizationFieldTemplate[]
  import_sources            ImportSource[]
  import_runs               ImportRun[]
  redirects                 StoreRedirect[]
  design_templates          DesignTemplate[]
  designs                   Design[]
  product_designers         ProductDesigner[]

  @@index([slug])
}

// Kustom-first checkout: the Kustom iframe is shown before any order exists.
// The session snapshots what the customer is buying (the same CartLine shape
// POST /cart/items accepts) plus the address country Kustom reported, so every
// callback can re-price the purchase without trusting Kustom's amounts. The
// order is created inside Kustom's validation callback and linked back here.
model KustomCheckoutSession {
  id                 String     @id @default(uuid())
  store_id           String
  // Set when the shopper was logged in; guests get an account at validation.
  customer_id        String?
  kustom_order_id    String?    @unique
  // Storefront secret (random 32-byte hex): authenticates PUT /session/:id,
  // GET /confirmation and the confirmation redirect URL. Returned to the
  // browser, so it must never unlock a server-side callback.
  token              String
  // Server-side secret (random 32-byte hex) carried only in the merchant URLs
  // Kustom calls (push, validation, address_update, shipping_option_update).
  // Never returned to the storefront.
  callback_token     String
  status             String     @default("open") // open | ordering | ordered | expired
  locale             String?    @db.VarChar(10)
  currency           String     @db.VarChar(3)
  items              Json // CartLine[] snapshot
  coupon_code        String?
  notes              String?
  // Last address country Kustom reported (drives the shipping options),
  // plus its region and postcode so the session is taxed for exactly the
  // destination the order created at validation will snapshot.
  country_code       String?    @db.VarChar(2)
  region             String?
  postcode           String?
  // purchase_country sent when the Kustom checkout was created; Kustom does
  // not accept a different value on update, so every update reuses it.
  purchase_country   String?    @db.VarChar(2)
  // Shipping option the customer selected in the iframe (Kustom option id)
  // and its cost for the current country.
  shipping_method_id String?
  shipping_cost      Decimal    @default(0) @db.Decimal(10, 2)
  order_id           String?    @unique
  // True when validation had to create the customer account for a guest;
  // surfaced on the confirmation page so the shopper knows how to log in.
  account_created    Boolean    @default(false)
  // Markets app: market and storefront host the session was opened on, so
  // the merchant URLs and the order created at validation carry them.
  market_id          String?
  hostname           String?
  // b2b app: buyer type the session was opened with and the company prefill
  // the storefront sent ({company_name, org_number, vat_number?, buyer_reference?}).
  buyer_type         BuyerType?
  company            Json?
  // b2b app M2.5: VatEvidence of company.vat_number; the Kustom callbacks
  // reuse it instead of calling VIES inside their time budget.
  vat_validation     Json?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  expires_at         DateTime

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
}

// Own SMTP sender for an INDEPENDENT store, so its customers receive mail from
// the creator's own domain instead of the platform's. Absent, disabled or
// incomplete means "use the platform sender". The password is encrypted at
// rest with the same envelope as the platform SMTP and the Stripe secrets.
model StoreMailSettings {
  id          String    @id @default(uuid())
  store_id    String    @unique
  smtp_host   String?
  smtp_port   Int?
  smtp_secure Boolean   @default(false)
  smtp_user   String?
  smtp_pass   String?
  mail_from   String?
  enabled     Boolean   @default(false)
  // Last time a test message went out successfully — surfaced in the dashboard
  // so a creator can tell a saved config from a working one.
  verified_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

enum EmailLogStatus {
  SENT
  FAILED
  SKIPPED
}

// One row per delivery attempt of a transactional email, so an admin or a
// creator can tell what was handed to the SMTP server and what failed (and
// why). Bodies are never stored. SENT means the SMTP server accepted the
// message — not that it reached the inbox. Rows older than 90 days are pruned.
model EmailLog {
  id         String         @id @default(uuid())
  store_id   String?
  order_id   String?
  event      String? // order_confirmation, new_order_owner, test, …
  recipient  String
  subject    String
  status     EmailLogStatus
  via        String? // 'store' | 'platform'
  smtp_host  String?
  error      String?
  created_at DateTime       @default(now())

  @@index([created_at])
  @@index([store_id, created_at])
}

// Per-store override of a transactional email template. Same per-locale JSON
// shape as NotificationTemplate so both go through one render path; a missing
// row simply falls through to the platform template.
model StoreNotificationTemplate {
  id         String   @id @default(uuid())
  store_id   String
  event      String
  subject    Json     @default("{}")
  body_html  Json     @default("{}")
  body_text  Json     @default("{}")
  enabled    Boolean  @default(true)
  updated_at DateTime @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, event])
  @@index([store_id])
}

// Per-store apps (feature add-ons such as markets / b2b / invoices). The row
// is the allowlist: `available` is set by an admin, `enabled` by the creator,
// and the app is in effect only when both are true. A store with no rows has
// no apps and behaves exactly as before the apps system existed. Keys come
// from the registry in src/common/store-apps/store-apps.registry.ts.
model StoreApp {
  id         String    @id @default(uuid())
  store_id   String
  app_key    String    @db.VarChar(32)
  available  Boolean   @default(false)
  enabled    Boolean   @default(false)
  settings   Json      @default("{}")
  enabled_at DateTime?
  // User.id of whoever last enabled it (not a relation on purpose).
  enabled_by String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, app_key])
  @@index([store_id])
}

model StoreLanguageConfig {
  id                String   @id @default(uuid())
  store_id          String   @unique
  primary_locale    String   @default("en") @db.VarChar(5)
  secondary_locales String[]
  auto_translate    Boolean  @default(false)
  fallback_locale   String   @default("en") @db.VarChar(5)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

// -- Markets app ------------------------------------------------------------
// A market is one country group a store sells to, with its own hostname(s),
// locales, currency and price rule. Every store has a default market (bound to
// the platform subdomain and the legacy custom_domain); the rows are inert
// until the "markets" store app is enabled.

enum MarketStatus {
  DRAFT
  LIVE
}

enum StoreDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
}

model Market {
  id              String       @id @default(uuid())
  store_id        String
  // URL/API handle ('se', 'eu'); 'default' for the default market.
  key             String       @db.VarChar(16)
  name            String
  // ISO2, upper-case.
  countries       String[]
  default_locale  String       @db.VarChar(5)
  // Served with a /xx/ prefix; never contains default_locale.
  locales         String[]
  currency        String       @db.VarChar(3)
  is_default      Boolean      @default(false)
  status          MarketStatus @default(DRAFT)
  // {mode:'convert'|'fixed', source:'manual'|'platform', rate?, rounding:{increment?, ending?}}
  price_rule      Json         @default("{}")
  // {stripe:'ok'|'missing'|'unknown', kustom:..., checked_at, details:{...}}
  payment_check   Json?
  // Reserved for a later milestone (per-market legal entity).
  legal_entity_id String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  store   Store                @relation(fields: [store_id], references: [id], onDelete: Cascade)
  domains StoreDomain[]
  prices  ProductMarketPrice[]
  orders  Order[]

  @@unique([store_id, key])
  @@index([store_id])
}

model StoreDomain {
  id            String            @id @default(uuid())
  store_id      String
  market_id     String
  // Lower-case, no port.
  hostname      String            @unique
  // Canonical host of the market.
  is_primary    Boolean           @default(false)
  // Hostname to 301 to (www -> apex).
  redirect_to   String?
  // PENDING -> VERIFIED (creator DNS check) -> ACTIVE (admin, after the CDN
  // step). Only ACTIVE hosts are served.
  status        StoreDomainStatus @default(PENDING)
  verified_at   DateTime?
  // DNS records (CNAME + A) seen by the last "Verify" call, string[].
  last_observed Json?
  created_at    DateTime          @default(now())

  store  Store  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  market Market @relation(fields: [market_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@index([market_id])
}

model ProductMarketPrice {
  id               String   @id @default(uuid())
  market_id        String
  product_id       String
  variant_id       String?
  // Manual override in the market currency; null = auto (converted).
  price            Decimal? @db.Decimal(10, 2)
  compare_at_price Decimal? @db.Decimal(10, 2)
  // false on the product-level row hides the product in this market.
  available        Boolean  @default(true)
  updated_at       DateTime @updatedAt

  market  Market          @relation(fields: [market_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  // Postgres treats NULL variant_id rows as distinct here; the migration adds
  // a partial unique index for the product-level row (variant_id IS NULL).
  @@unique([market_id, product_id, variant_id])
  @@index([product_id])
}

// Platform-provided FX rates (admin-maintained; a fetch job can fill it later).
model PlatformFxRate {
  id         String   @id @default(uuid())
  base       String   @db.VarChar(3)
  quote      String   @db.VarChar(3)
  rate       Decimal  @db.Decimal(18, 8)
  updated_at DateTime @updatedAt

  @@unique([base, quote])
}

// ==========================================
// Taxes (plans/tax-system/API-CONTRACT-TAX.md)
// ==========================================

enum TaxPricingMode {
  INCLUSIVE
  EXCLUSIVE
}

// Buyer kind of a customer / order (b2b app). Null = PERSON (pre-app rows).
enum BuyerType {
  PERSON
  COMPANY
}

// Why an order carries no VAT (b2b app, M2.5). Null = taxed normally.
enum TaxExemptReason {
  REVERSE_CHARGE
  CUSTOMER_EXEMPT
}

// Kind of a merchant-granted customer exemption (b2b app, M2.5).
enum TaxExemptionKind {
  REVERSE_CHARGE
  FULL
}

// Outcome of one VIES consultation (b2b app, M2.5).
enum VatCheckStatus {
  VALID
  INVALID
  UNAVAILABLE
}

// Every VIES consultation (evidence + L2 cache). Rows are never updated.
model VatNumberCheck {
  id                 String         @id @default(uuid())
  // Normalised, with the VIES prefix (EL..., XI...).
  vat_number         String         @db.VarChar(32)
  // VIES member-state code (EL, XI).
  country_code       String         @db.VarChar(2)
  status             VatCheckStatus
  // MS_UNAVAILABLE, TIMEOUT, ...
  error_code         String?        @db.VarChar(40)
  name               String?
  address            String?
  request_identifier String?        @db.VarChar(64)
  requester          String?        @db.VarChar(32)
  // VIES requestDate.
  request_date       DateTime?
  checked_at         DateTime       @default(now())
  // Who asked (no FK on purpose).
  store_id           String?
  // storefront | quote | order | kustom | dashboard
  source             String         @db.VarChar(16)
  // VIES_MODE that answered (live | mock): mock rows never serve live.
  mode               String         @default("live") @db.VarChar(8)

  @@index([vat_number, checked_at])
}

// A merchant's "don't collect tax" decision for one customer of one store.
// At most one active (revoked_at null) row per (store, customer): enforced by
// the partial unique index StoreCustomerTaxExemption_active (migration SQL).
model StoreCustomerTaxExemption {
  id          String           @id @default(uuid())
  store_id    String
  customer_id String
  kind        TaxExemptionKind
  vat_number  String?          @db.VarChar(32)
  note        String?          @db.VarChar(500)
  // User.id
  created_by  String
  created_at  DateTime         @default(now())
  revoked_at  DateTime?
  revoked_by  String?

  store    Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([store_id, customer_id])
}

enum TaxBasis {
  SHIPPING
  BILLING
  STORE
}

// A tax class groups products that are taxed alike ('standard', 'reduced',
// 'zero' or a custom slug). store_id null = platform class; exactly one class
// per scope is the default (used by products with no class).
model TaxClass {
  id         String   @id @default(uuid())
  store_id   String?
  key        String
  name       Json // { "en": "Standard", "sv": "Standard", ... }
  is_default Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  store    Store?    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  rates    TaxRate[]
  products Product[]

  @@unique([store_id, key])
}

// One rate of a class for a destination. store_id null = platform rate.
// region: state/province code (exact match), null = any. postcode_pattern:
// null = any, "123*" prefix or "10000-19999" range. Among matches the most
// specific wins (postcode > region > country), then the lowest priority;
// rates with the same priority stack (compound).
model TaxRate {
  id                  String   @id @default(uuid())
  store_id            String?
  tax_class_id        String
  country             String   @db.VarChar(2)
  region              String?
  postcode_pattern    String?
  rate_bp             Int // 2500 = 25 %
  label               Json // { "en": "VAT", "sv": "Moms", ... }
  priority            Int      @default(0)
  applies_to_shipping Boolean  @default(true)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())

  store     Store?   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  tax_class TaxClass @relation(fields: [tax_class_id], references: [id], onDelete: Cascade)

  @@index([country, tax_class_id])
  @@index([store_id])
}

model StaticPage {
  id          String         @id @default(uuid())
