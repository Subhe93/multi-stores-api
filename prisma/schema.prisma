  usages       PromotionUsage[]

  @@index([coupon_code])
  @@index([status])
  @@index([level])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  BUNDLE
  QUANTITY_DISCOUNT
  FREE_SHIPPING
  COUPON
  FLASH_SALE
}

enum PromotionLevel {
  PROVIDER_TO_CREATOR
  CREATOR_TO_CUSTOMER
}

enum PromotionStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

model PromotionTranslation {
  id           String  @id @default(uuid())
  promotion_id String
  locale       String  @db.VarChar(5)
  title        String
