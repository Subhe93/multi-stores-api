model BundleCustomProduct {
  bundle_id         String
  custom_product_id String

  bundle         Bundle        @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  custom_product CustomProduct @relation(fields: [custom_product_id], references: [id], onDelete: Cascade)

  @@id([bundle_id, custom_product_id])
  @@index([custom_product_id])
}

enum BundleDiscountType {
  ITEM
  PERCENTAGE
  FIXED
}

enum BundleStatus {
  ACTIVE
  DISABLED
}

// ==========================================
// Invoices app (M3)
// ==========================================

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

// What caused the document (audit + idempotency semantics).
enum InvoiceTrigger {
  PAYMENT
  COD_CREATED
  COD_DELIVERED
  MANUAL
  REFUND
  CANCELLATION
}

// Invoices app: legal identity of the seller shown on invoices and order
// emails. One 'default' profile per store in M3; Market.legal_entity_id may
// point here later. Columns nullable so the form can be saved progressively;
// completeness is checked before issuing.
model StoreLegalProfile {
  id                String   @id @default(uuid())
  store_id          String
  key               String   @default("default") @db.VarChar(32)
  legal_name        String?
  brand_name        String?
  org_number        String?  @db.VarChar(32)
  vat_number        String?  @db.VarChar(32)
  address_line1     String?
  address_line2     String?
  postal_code       String?  @db.VarChar(16)
  city              String?
  country_code      String?  @db.VarChar(2)
  registered_office String? // "Säte" (Swedish AB requirement)
  email             String?
  phone             String?
  website           String?
  bankgiro          String?  @db.VarChar(16)
  plusgiro          String?  @db.VarChar(16)
  iban              String?  @db.VarChar(34)
  bic               String?  @db.VarChar(11)
  bank_name         String?
  logo_url          String? // /uploads/... (public logo) or https; null = Store.logo_url
  f_tax_approved    Boolean  @default(false) // "Godkänd för F-skatt"
  due_days          Int      @default(30)
  footer_note       String?
  timezone          String   @default("Europe/Stockholm") @db.VarChar(64)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  store     Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  sequences InvoiceSequence[]

  @@unique([store_id, key])
  @@index([store_id])
}

// One gapless series per (profile, kind). A number is allocated under
// SELECT ... FOR UPDATE inside the transaction that inserts the invoice.
model InvoiceSequence {
  id               String      @id @default(uuid())
  legal_profile_id String
  store_id         String
  kind             InvoiceKind
  prefix           String      @default("") @db.VarChar(12)
  padding          Int         @default(0)
  start_number     Int         @default(1) // as configured (audit)
  next_number      Int         @default(1)
  issued_count     Int         @default(0)
  last_issued_at   DateTime?
  updated_at       DateTime    @updatedAt

  legal_profile StoreLegalProfile @relation(fields: [legal_profile_id], references: [id], onDelete: Cascade)

  @@unique([legal_profile_id, kind])
  @@index([store_id])
}

// An issued invoice or credit note: an immutable snapshot plus scalar columns
// for lists. Amounts are signed (credit notes negative). A trigger
// (prisma/sql/invoice-guards.sql) rejects DELETE and any UPDATE except the PDF
// / email bookkeeping columns.
model Invoice {
  id                  String           @id @default(uuid())
  store_id            String // no FK on purpose (survives store deletion, like Order.store_id)
  legal_profile_id    String // no FK on purpose
  order_id            String
  kind                InvoiceKind
  sequence_number     Int
  number              String           @db.VarChar(40)
  credited_invoice_id String?
  trigger             InvoiceTrigger
  idempotency_key     String           @db.VarChar(120)
  issue_date          DateTime         @db.Date
  due_date            DateTime?        @db.Date
  issued_at           DateTime         @default(now())
  issued_by           String? // User.id; null = system
  currency            String           @db.VarChar(3)
  locale              String           @db.VarChar(10)
  net_total           Decimal          @db.Decimal(12, 2) // signed
  vat_total           Decimal          @db.Decimal(12, 2)
  gross_total         Decimal          @db.Decimal(12, 2)
  paid                Boolean
  buyer_type          BuyerType?
  buyer_name          String
  buyer_email         String?
  // b2b app M2.5: reverse charge / exemption snapshot (written on INSERT only).
  tax_exempt_reason   TaxExemptReason?
  buyer_vat_number    String?          @db.VarChar(32)
  buyer_country       String?          @db.VarChar(2)
  order_number        String
  reason              String?
  snapshot            Json
  snapshot_version    Int              @default(1)
  snapshot_sha256     String           @db.VarChar(64)
  // Mutable bookkeeping (the only columns the immutability trigger allows).
  pdf_path            String?
  pdf_sha256          String?          @db.VarChar(64)
  pdf_generated_at    DateTime?
  emailed_at          DateTime?
  created_at          DateTime         @default(now())

  order            Order     @relation(fields: [order_id], references: [id], onDelete: Restrict)
  credited_invoice Invoice?  @relation("InvoiceCredits", fields: [credited_invoice_id], references: [id], onDelete: Restrict)
  credit_notes     Invoice[] @relation("InvoiceCredits")

  @@unique([legal_profile_id, kind, sequence_number])
  @@unique([store_id, kind, number])
  @@unique([store_id, idempotency_key])
  @@index([store_id, issue_date])
  @@index([order_id])
}

// ==========================================
// Importer store app (M4.4) + platform redirects
// ==========================================

enum ImportSourceKind {
  WP_BUNDLE
  WC_REST
}

enum ImportRunStatus {
  UPLOADED
  PLANNING
  PLANNED
  PLAN_FAILED
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
  ROLLBACK_QUEUED
  ROLLING_BACK
  ROLLED_BACK
  ROLLBACK_FAILED
}

enum ImportItemPhase {
  PLAN
  APPLY
  ROLLBACK
}

enum ImportItemAction {
  CREATE
  UPDATE
  UNCHANGED
  SKIP
  CONFLICT
  ERROR
  DELETE
  ARCHIVE
  STAGE
}

enum ImportLogLevel {
  INFO
  WARN
  ERROR
}

enum ImportEntityStatus {
  ACTIVE
  STAGED
  ROLLED_BACK
}

enum RedirectSource {
  IMPORT
  MANUAL
}

model ImportSource {
  id               String           @id @default(uuid())
  store_id         String
  kind             ImportSourceKind
  name             String
  site_host        String           @db.VarChar(253) // lower-case, no scheme/port
  host_aliases     String[] // rewritten to site_host
  credentials_enc  String? // REST key:secret, CryptoService
  settings         Json             @default("{}") // {product_base, category_base, tag_base, locale, currency, uploads_path}
  last_verified_at DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  store Store       @relation(fields: [store_id], references: [id], onDelete: Cascade)
  runs  ImportRun[]

  @@unique([store_id, site_host, kind])
  @@index([store_id])
}

// One active run per store is enforced by the partial unique index
// "ImportRun_one_active_per_store" (raw SQL in 20261025120000_add_importer):
//   CREATE UNIQUE INDEX "ImportRun_one_active_per_store" ON "ImportRun"("store_id")
//   WHERE "status" IN ('PLANNING','QUEUED','RUNNING','ROLLBACK_QUEUED','ROLLING_BACK');
// Prisma cannot model a partial index. `prisma migrate dev` will offer a
// migration that DROPS it: delete that statement from any generated
// migration (the importer's API pre-check alone is not race-safe).
model ImportRun {
  id                  String          @id @default(uuid())
  store_id            String
  source_id           String
  status              ImportRunStatus @default(UPLOADED)
  bundle_key          String? // private storage key
  bundle_sha256       String?         @db.VarChar(64)
  bundle_bytes        Int?
  snapshot_key        String? // normalized catalog JSON.gz (private)
  catalog_hash        String?         @db.VarChar(64)
  options             Json            @default("{}")
  plan_fingerprint    String?         @db.VarChar(64)
  summary             Json? // counts per entity x action, warnings by code
  progress            Json? // {phase, done, total, cursor}
  error               String? // code + message (<= 2 KB)
  attempt             Int             @default(0)
  worker_id           String?
  heartbeat_at        DateTime?
  cancel_requested_at DateTime?
  created_by          String? // User.id (no relation, like StoreApp.enabled_by)
  confirmed_by        String?
  rollback_by         String?
  planned_at          DateTime?
  started_at          DateTime?
  finished_at         DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  store  Store           @relation(fields: [store_id], references: [id], onDelete: Cascade)
  source ImportSource    @relation(fields: [source_id], references: [id], onDelete: Cascade)
  items  ImportRunItem[]
  logs   ImportRunLog[]

  @@index([store_id, created_at])
  @@index([status])
}

// Plan/apply/rollback ledger per run (audit + dry-run equality).
model ImportRunItem {
  id           String           @id @default(uuid())
  run_id       String
  phase        ImportItemPhase
  entity_type  String           @db.VarChar(32)
  external_ref String           @db.VarChar(255)
  action       ImportItemAction
  target_id    String?
  before       Json? // UPDATE: managed fields before
  diff         Json? // field-level summary for the report
  message      String?
  created_at   DateTime         @default(now())

  run ImportRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id, phase, entity_type])
}

model ImportRunLog {
  id           String         @id @default(uuid())
  run_id       String
  level        ImportLogLevel
  code         String         @db.VarChar(64)
  entity_type  String?        @db.VarChar(32)
  external_ref String?        @db.VarChar(255)
  message      String
  data         Json?
  created_at   DateTime       @default(now())

  run ImportRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id, level])
}

// Cross-run ledger (identity + change detection + rollback). No FKs on
// purpose: it outlives runs ("DELETE runs/:id" keeps the ledger). Rows of a
// deleted store (also ImportMedia) are removed by the `importer.bundles`
// retention task.
model ImportEntity {
  id                String             @id @default(uuid())
  store_id          String
  entity_type       String             @db.VarChar(32)
  external_ref      String             @db.VarChar(255)
  target_id         String?
  source_hash       String             @db.VarChar(64)
  applied_hash      String?            @db.VarChar(64)
  created_by_import Boolean            @default(true) // false = adopted existing
  status            ImportEntityStatus @default(ACTIVE)
  payload           Json? // STAGED hand-offs (presets, templates)
  first_run_id      String
  last_run_id       String
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  @@unique([store_id, entity_type, external_ref])
  @@index([store_id, first_run_id])
}

model ImportMedia {
  id           String   @id @default(uuid())
  store_id     String
  source_url   String   @db.VarChar(1024) // normalized, after alias rewrite
  fetched_url  String?  @db.VarChar(1024) // candidate that succeeded (original vs -scaled)
  sha256       String   @db.VarChar(64)
  mime         String   @db.VarChar(64)
  bytes        Int
  width        Int?
  height       Int?
  public_url   String? // /uploads/imports/... (product/category/swatch)
  private_key  String? // importer/<store>/media/<sha>.<ext> (templates)
  first_run_id String
  created_at   DateTime @default(now())

  @@unique([store_id, source_url])
  @@index([store_id, sha256])
}

// Platform-level 301/302 map per store. Written by the importer
// (source=IMPORT) or the merchant (MANUAL); survives disabling the app.
model StoreRedirect {
  id            String         @id @default(uuid())
  store_id      String
  from_path     String         @db.VarChar(1024) // normalized (redirect-path.util)
  to_path       String         @db.VarChar(1024) // absolute path on the same host
  status_code   Int            @default(301)
  source        RedirectSource @default(MANUAL)
  import_run_id String?
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, from_path])
  @@index([store_id, updated_at])
}

// ==========================================
// Designer store app (M4.2, migration 20261026120000_add_designer)
// ==========================================
// Product designer: millimetre templates (immutable versions), a customer
// design per product (draft -> cart -> order), private assets and a frozen
// per-order-item snapshot with the print-render queue. Changes to existing
// tables are a nullable column (CartItem.design_id) or relations only.

enum DesignTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DesignAssetKind {
  CUSTOMER_PHOTO
  TEMPLATE_BG_WEB
  TEMPLATE_BG_PRINT
  TEMPLATE_DECO
  TEMPLATE_THUMB
  FONT
}

enum DesignStatus {
  DRAFT
  IN_CART
  ORDERED
}

enum DesignPrintStatus {
  PENDING
  RENDERING
  READY
  FAILED
  PURGED
}

model DesignTemplate {
  id                 String               @id @default(uuid())
  store_id           String
  name               String               @db.VarChar(160)
  status             DesignTemplateStatus @default(DRAFT)
  // Published version used for NEW designs (no FK: versions are immutable).
  current_version_id String?
  source             String               @default("native") @db.VarChar(16) // native | npp
  // Importer identity "woo:<site_host>:npp_template:<id>" (M4.5 C7).
  external_ref       String?              @db.VarChar(191)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  store    Store                   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  versions DesignTemplateVersion[]
  products ProductDesigner[]

  @@unique([store_id, source, external_ref])
  @@index([store_id, status])
}

// Immutable once created.
model DesignTemplateVersion {
  id            String   @id @default(uuid())
  template_id   String
  version       Int
  spec          Json // TemplateSpecV1
  spec_sha256   String   @db.VarChar(64)
  thumbnail_url String? // public proof-style render of the defaults
  created_by    String? // User.id
  created_at    DateTime @default(now())

  template DesignTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  designs  Design[]

  @@unique([template_id, version])
}

model ProductDesigner {
  product_id  String   @id
  store_id    String
  template_id String
  enabled     Boolean  @default(false)
  // Imported NPP add-ons, ALWAYS disabled in M4.2 (never read for pricing).
  addons      Json     @default("{}")
  updated_at  DateTime @updatedAt

  product  Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  // NoAction (checked at the end of the statement): a template linked to a
  // product still cannot be deleted, but a store / creator deletion that
  // cascades to both the template and the link no longer fails on order.
  template DesignTemplate @relation(fields: [template_id], references: [id], onDelete: NoAction)
  // M4.2 fixes: deleting the store removes its links.
  store    Store          @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@index([template_id])
}

model DesignAsset {
  id          String          @id @default(uuid())
  store_id    String
  kind        DesignAssetKind
  design_id   String? // CUSTOMER_PHOTO only
  private_key String? // designer/<store>/<yyyy>/<kind>/<id>.<ext> (canonical bytes)
  preview_key String? // private preview (photo)
  public_url  String? // public API path (web bg, deco, thumb, font) or null
  mime        String          @db.VarChar(32)
  width       Int
  height      Int
  bytes       Int
  sha256      String          @db.VarChar(64)
  // FONT: {family,weight,style,format,subsets?}; template assets:
  // {template_id?, replaces?}; import: {source_url, warnings}.
  meta        Json?
  created_at  DateTime        @default(now())
  purged_at   DateTime?

  design Design? @relation(fields: [design_id], references: [id], onDelete: SetNull)

  @@index([store_id, kind])
  @@index([design_id])
  @@index([kind, created_at])
}

model Design {
  id                  String       @id @default(uuid())
  store_id            String
  product_id          String
  template_version_id String
  state               Json // DesignStateV1
  state_version       Int          @default(1) // optimistic concurrency
  status              DesignStatus @default(DRAFT)
  customer_id         String? // owner when logged in / claimed
  access_token_hash   String       @db.VarChar(64) // sha256(random 32B) for guests
  proof_key           String? // private webp
  proof_state_sha     String?      @db.VarChar(64)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  assets           DesignAsset[]
  // NoAction: a version used by designs cannot be deleted, but a store
  // deletion (cascading to the designs below AND the templates) succeeds.
  template_version DesignTemplateVersion @relation(fields: [template_version_id], references: [id], onDelete: NoAction)
  // M4.2 fixes: deleting the store removes its designs (their photo rows
  // keep design_id = null and R2 deletes the files).
  store            Store                 @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, status, updated_at])
  @@index([customer_id])
}

// Frozen design of one order item + the print-render queue row.
model OrderItemDesign {
  id                    String            @id @default(uuid())
  order_item_id         String            @unique
  order_id              String
  store_id              String
  design_id             String? // no FK (the draft may be purged)
  template_id           String
  template_version_id   String
  template_spec         Json // frozen copy
  state                 Json // frozen copy (validated)
  assets                Json // [{asset_id, role, element_id?, width, height, sha256, low_res?, effective_dpi?}]
  text_values           Json // [{element_id, label, value}]
  price_breakdown       Json // {designer_delta:0, addons:[]}
  renderer_version      String            @db.VarChar(16)
  proof_key             String?
  print_status          DesignPrintStatus @default(PENDING)
  print_attempts        Int               @default(0)
  print_next_attempt_at DateTime?
  print_locked_at       DateTime?
  print_error           String?
  print_files           Json? // [{surface, format, key, width_px, height_px, dpi, bytes, sha256}]
  print_rendered_at     DateTime?
  print_requested_at    DateTime? // set on paid/COD/regenerate; null = not yet payable
  shipped_at            DateTime?
  terminal_at           DateTime? // CANCELLED/REFUNDED
  originals_purged_at   DateTime?
  files_purged_at       DateTime?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  order_item OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)

  @@index([store_id, print_status])
  @@index([print_status, print_next_attempt_at])
  @@index([order_id])
  @@index([design_id])
}

// M5 W1-C: upload byte budgets shared across API instances (customer uploads
// and designer photos), one row per scope/key and UTC day. Written with raw
// SQL (atomic INSERT ... ON CONFLICT), purged by the `ops.quota-windows`
// retention task.
model UploadQuotaWindow {
  scope        String   @db.VarChar(32) // customer.ip | designer.ip | designer.store
  key          String   @db.VarChar(64) // sha256 hex of the IP / store id
  window_start DateTime
  bytes        BigInt   @default(0)
  updated_at   DateTime @default(now())

  @@id([scope, key, window_start])
  @@index([window_start])
}

// M5 W1-C: last scheduler tick per (job, instance) for the ops status
// endpoint; `ran_at`/`ran_payload` keep the last tick that did work.
// Purged by the `ops.job-ticks` retention task.
model OpsJobTick {
  job         String    @db.VarChar(64)
  instance    String    @db.VarChar(191)
  ticked_at   DateTime
  outcome     String    @db.VarChar(16) // ran | idle | skipped | error
  payload     Json?
  ran_at      DateTime?
  ran_payload Json?

  @@id([job, instance])
  @@index([ticked_at])
}
