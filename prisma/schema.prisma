  product            Product                        @relation(fields: [product_id], references: [id])
  creator            Creator                        @relation(fields: [creator_id], references: [id])
  mockup_images      CustomProductImage[]
  translations       CustomProductTranslation[]
  selected_variants  CustomProductVariant[]
  field_values       CustomProductFieldValue[]
  faqs               CustomProductFaq[]
  order_items        OrderItem[]
  bundles            BundleCustomProduct[]
  creator_categories CustomProductCreatorCategory[]
}

model CustomProductCreatorCategory {
