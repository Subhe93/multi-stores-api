DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/multi_stores?schema=public"
REDIS_URL="redis://localhost:6379"

# Two DIFFERENT random values (the API refuses to start if they match):
# openssl rand -base64 48
JWT_SECRET="change-me-access"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption key for secrets at rest (Stripe keys, SMTP password) — AES-256-GCM.
# Must decode to exactly 32 bytes. Generate with:  openssl rand -base64 32
# Keep this OUT of the database and never commit the real value. Losing it means
# stored secrets can no longer be decrypted (re-enter them from the admin panel).
ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# KMS envelope for the key above (Phase 4, optional). When set, the API unwraps
# it with AWS KMS Decrypt at startup and ENCRYPTION_KEY is no longer needed
# (keep it for one deploy, then remove it; see plans/s3-storage/KMS.md).
# Produce it with: npx ts-node prisma/scripts/wrap-encryption-key.ts --out <file> --verify
# ENCRYPTION_KEY_WRAPPED="base64-of-kms-ciphertext-blob"
# KMS key id, ARN or alias used for the wrap (optional for Decrypt, required for the wrap script).
# KMS_KEY_ID="alias/shopsdoor-envelope"
# Refuse to start when the KMS unwrap fails instead of falling back to
# ENCRYPTION_KEY. Default: true when NODE_ENV=production, false otherwise.
# CRYPTO_STRICT_STARTUP=true
# AWS_REGION is shared with the S3 storage settings (e.g. eu-north-1).

PORT=3001
NODE_ENV=development

# Storefront cache revalidation. STOREFRONT_URL is the Next.js web app base URL;
# REVALIDATE_SECRET must match the web app's value.
STOREFRONT_URL="http://localhost:3003"
REVALIDATE_SECRET="change-me"

# Public base URL of this API (no trailing slash, no /api). Used to build
# absolute links in emails and the Kustom push/validation callback URLs, so
# it must be reachable from the internet in production (use a tunnel such as
# ngrok when testing Kustom locally — Kustom cannot call localhost).
PUBLIC_API_URL="http://localhost:3001"

# Kustom Checkout (former Klarna Checkout): no credentials are configured
# here. Each creator stores their own Merchant ID + shared secret from the
# dashboard (encrypted at rest), and the admin may set the platform's
# Kustom-Partner id in the admin payments settings. The API only needs
# STOREFRONT_URL + PUBLIC_API_URL above to build the merchant URLs.

# CORS. Comma-separated list of allowed browser origins. Entries are exact
# origins or one-level wildcards ("https://*.iwings-digital.com" matches
# "https://shop.iwings-digital.com" but not "https://a.b.iwings-digital.com").
# Origins not in the list are still accepted when they equal a store's
# custom_domain (with or without "www."; looked up and cached for 5 minutes).
# http://localhost:* is always allowed. Leave empty to reflect every origin
# (logs a warning at startup).
CORS_ALLOWED_ORIGINS="https://iwings-digital.com,https://*.iwings-digital.com,https://ms-dash.iwings-digital.com"

# Markets app — custom hostnames. The DNS target a creator must point a
# market hostname at (shown in the dashboard, checked by "Verify"): the CNAME
# target, and optionally the A record address for apex domains. Hosts become
# ACTIVE only when an admin promotes them after the CDN/proxy step
# (PUT /markets/admin/domains/:id/status).
# Set by ops to the hostname creators must CNAME to (left empty, the
# dashboard shows no target and "Verify" always fails).
# CUSTOM_DOMAIN_CNAME_TARGET=   # optional override; default = <slug>.<STOREFRONT_URL host>
# CUSTOM_DOMAIN_A_TARGET=
# Optional: DNS lookup timeout for "Verify" in milliseconds (default 5000).
# CUSTOM_DOMAIN_DNS_TIMEOUT_MS=5000
# CUSTOM_DOMAIN_HTTP_VERIFY=on   # off = DNS match only (no https probe of the hostname)

# Admin backups. BACKUP_DIR is where pg_dump files and uploads archives are
# written (absolute path recommended; default: <cwd>/backups; production uses
# /var/backups/multi-stores). It is created on demand and never served
# statically. The server needs pg_dump, pg_restore and tar on PATH.
# BACKUP_DIR="/var/backups/multi-stores"
# Set BACKUP_SCHEDULER=off to disable the 60 s scheduler tick (dev / tests);
# manual backups from the admin panel keep working.
# BACKUP_SCHEDULER=off

# Invoices app — PDF engine and private storage.
# INVOICE_PDF_ENGINE: chromium (default) | off. With "off" (or when no browser
# can be launched) invoices are still issued; the PDF endpoint returns 503
# INVOICE_PDF_UNAVAILABLE and order emails go out without the attachment.
# INVOICE_PDF_ENGINE=chromium
# Browser for playwright-core. Production: point at a headless Chromium
# (e.g. after `npx playwright install --with-deps chromium-headless-shell`, or
# the distro's /usr/bin/chromium). Dev on Windows: leave both empty to use the
# installed Edge, then Chrome; or set the channel explicitly. The shared
# CHROMIUM_PATH / CHROMIUM_CHANNEL (see "Operability") apply when these are
# unset.
# INVOICE_PDF_CHROMIUM_PATH="/usr/bin/chromium"
# INVOICE_PDF_BROWSER_CHANNEL=msedge
# Where rendered invoice PDFs are kept (private, never under uploads/; include
# it in backups). Default: <cwd>/storage/invoices.
# INVOICE_STORAGE_DIR="/var/lib/multi-stores/invoices"
# Max time (ms) an order email waits for invoice PDFs to render before it is
# sent without them; a skipped PDF is attached to the next document email.
# INVOICE_EMAIL_PDF_BUDGET_MS=8000

# B2B app, EU reverse charge (M2.5): VAT-number checks against VIES.
# live = EC REST service (default), mock = local rules (test numbers 100 valid,
# 200 invalid, 201/300/301/302/500/600 errors; other numbers ending 0000
# invalid, 9999 unavailable, 8888 timeout, anything else valid), off = never
# valid (VAT is always charged). Failures are fail-closed (VAT charged).
# VIES_MODE=live
# A base ending in /check-vat-test-service (staging) is used as is.
# VIES_BASE_URL="https://ec.europa.eu/taxation_customs/vies/rest-api"
# VIES_TIMEOUT_MS=4000
# VIES_CACHE_TTL_HOURS=24
# Max wait (ms) for a free VIES slot before a check fails closed (4 slots,
# public storefront checks may use at most 2).
# VIES_QUEUE_TIMEOUT_MS=2000
# Trader details (onboarding wave 3): a given VAT number is checked against
# VIES on save (6 s timeout; same VIES_BASE_URL). Invalid = 400
# TRADER_VAT_INVALID; VIES unavailable = accepted with vat_check.valid null.

# Cloudflare Turnstile on the platform sign-up (onboarding wave 3). Unset =
# captcha off ("turnstile: off" at boot). Set = POST /auth/register for
# store-owner / supplier kinds requires `turnstile_token` (400
# AUTH_CAPTCHA_FAILED, 503 AUTH_CAPTCHA_UNAVAILABLE when Cloudflare cannot
# be reached). The matching site key goes to the web app
# (NEXT_PUBLIC_TURNSTILE_SITE_KEY).
# TURNSTILE_SECRET_KEY=

# Private file storage (M4.0+): customer upload originals, later designer and
# importer files. Never under uploads/ (which is public). Default:
# <cwd>/storage. Backups that include uploads also archive it when it lives
# under the working directory.
# PRIVATE_STORAGE_DIR="/var/lib/multi-stores/storage"

# Retention job (hourly; one instance at a time via a Postgres advisory lock).
# RETENTION_SCHEDULER=off disables the hourly tick; the admin endpoint
# POST /api/admin/retention/run?dry_run=1&task=<key> keeps working.
# RETENTION_SCHEDULER=off
# Customer uploads: days to keep files attached to orders when no app policy
# applies (unset = keep forever). Purged only when every order using the file
# is shipped, delivered, cancelled, refunded or returned.
# CUSTOMER_UPLOAD_RETENTION_DAYS=60
# Days before uploads that never reached an order are purged (default 30, min 1).
# CUSTOMER_UPLOAD_ORPHAN_DAYS=30
# Abuse guards of the public POST /api/uploads/customer: per-IP byte budget
# per UTC day (Postgres table UploadQuotaWindow, shared by every API
# instance, in-memory fallback on a DB hiccup; default 500 MB = 524288000,
# 0 = off; over it → 429 CUSTOMER_UPLOAD_QUOTA) and the free-disk floor in MB on the
# disks holding storage/ and uploads/ (default 1024, 0 = off; below it → 503
# CUSTOMER_UPLOAD_STORAGE_FULL).
# CUSTOMER_UPLOAD_DAILY_BYTES_PER_IP=524288000
# CUSTOMER_UPLOAD_MIN_FREE_MB=1024

# Reverse proxy: set so req.ip is the real client (per-IP throttles and the
# upload byte budget). A hop count ("1" behind one nginx) or "loopback".
# Unset = no proxy trusted (req.ip is the proxy's address: every client then
# shares one budget).
# TRUST_PROXY=1

# Extra public origins of this API (comma separated, scheme://host[:port]),
# besides PUBLIC_API_URL. Absolute customer file URLs in cart/order values
# must point at one of them. In production (NODE_ENV=production) with none
# configured, absolute file URLs are refused (relative /uploads/... still work).
# API_PUBLIC_ORIGINS="https://api.example.com,https://api-cdn.example.com"

# Importer (M4.4). Bundle upload POST /api/importer/my/runs: at most 50 MB in
# total (enforced while streaming, 413 IMPORT_BUNDLE_TOO_LARGE) and 40 MB per
# file. nginx must let the body through for that route only, e.g.
#   location = /api/importer/my/runs { client_max_body_size 55M; proxy_pass ...; }
# (keep the smaller global client_max_body_size elsewhere).
# Media bytes one store may download per rolling 24 h over all runs (default
# 2 GB = 2147483648); images past it are reported as IMPORT_MEDIA_QUOTA.
# IMPORT_MEDIA_QUOTA_BYTES=2147483648

# Shared secret of the web storefront proxy for the public redirect routes
# (GET /api/stores/:slug/redirects and .../redirects/resolve). Set the SAME
# value on the API and the web (multi-stores-web); the proxy sends it as the
# `x-proxy-key` header and a match (timing-safe, at least 16 characters) lifts
# the 120/min per-IP throttle of those two routes. Unset or wrong = the normal
# per-IP throttle. Generate with: openssl rand -hex 32
# REDIRECTS_PROXY_KEY=

# Designer app (M4.2). HMAC secret of the signed private-file links
# (/api/designer/files/<token>: customer photo previews, print backgrounds,
# proofs). REQUIRED when NODE_ENV=production: the API refuses to boot without
# it (at least 32 characters; generate with: openssl rand -hex 32). In
# development, unset = a key derived from JWT_SECRET.
# DESIGNER_URL_SECRET="change-me-to-a-long-random-string"
# Proof links in order emails expire at the files purge date but at most this
# many days after the email is sent (1-365, default 30).
# DESIGNER_MAIL_LINK_MAX_DAYS=30
#
# Storefront designer photo uploads (public route), checked before the body
# is read: per-IP and per-store bytes per rolling 24 h (0 = off), live photos
# per design, and a free-disk floor under PRIVATE_STORAGE_DIR (default:
# CUSTOMER_UPLOAD_MIN_FREE_MB, else 1024). 429 DESIGNER_UPLOAD_QUOTA /
# 503 DESIGNER_STORAGE_FULL. Byte counters live in Postgres (UploadQuotaWindow,
# per UTC day, shared by every instance; in-memory fallback on a DB hiccup).
# DESIGNER_UPLOAD_DAILY_BYTES_PER_IP=524288000
# DESIGNER_UPLOAD_DAILY_BYTES_PER_STORE=5368709120
# DESIGNER_MAX_PHOTOS_PER_DESIGN=10
# DESIGNER_UPLOAD_MIN_FREE_MB=1024

# Designer render pipeline (M4.2 WP5): proofs and 3000x4200 print PNGs are
# rendered in the designer's OWN headless Chromium (playwright-core, like the
# invoice PDFs; no network, every request served from memory).
# DESIGNER_RENDER_ENGINE: chromium (default) | off. "off" = no browser at all:
# proofs answer 503 DESIGNER_RENDER_UNAVAILABLE and the print worker stays off.
# DESIGNER_RENDER_ENGINE=chromium
# Browser selection; unset = INVOICE_PDF_CHROMIUM_PATH / INVOICE_PDF_BROWSER_CHANNEL,
# then CHROMIUM_PATH / CHROMIUM_CHANNEL, else Edge/Chrome on Windows, else
# Playwright's managed browser.
# DESIGNER_CHROMIUM_PATH="/usr/bin/chromium"
# DESIGNER_BROWSER_CHANNEL=msedge
# Print queue worker on this instance (DB-backed, safe across instances):
# "off" for tests or instances that must not render (DESIGNER_WORKER=off is an
# alias). Orders are still queued and rendered by another instance.
# DESIGNER_RENDER_QUEUE=on
# Parallel print jobs per instance: 1 (default) or 2. RAM per print job:
# the 3000x4200 canvas (~50 MB) + its PNG encode (~50 MB) in the browser,
# the photo bitmaps (pre-cut to the visible slot region and pre-scaled, so
# at most the slot's pixels: ~15 MB each) and the sharp finalize in Node
# (~100 MB peak). Budget ~250 MB per job on top of the ~200 MB browser
# baseline: concurrency 1 needs ~0.5 GB free, concurrency 2 ~0.8 GB free
# (plus the API itself). Also the size of the print lane of the designer
# browser; proofs have their own lane (1 slot, 8 waiting, 5 s wait), so
# neither starves the other.
# DESIGNER_RENDER_CONCURRENCY=1
#
# Fonts on the API host: every template face is uploaded by the creator and
# served to the browser from memory, so no system font is needed for the
# text itself. Characters a face lacks are refused at save / cart time
# (DESIGNER_STATE_INVALID rule "chars"), EXCEPT emoji / pictographs (the
# imported templates allow a heart), which Chromium draws from a system
# fallback font. Install on the host (Debian/Ubuntu):
#   apt-get install -y fonts-noto-core fonts-noto-color-emoji
# and `fc-cache -f`; without them an emoji prints as a tofu box.
#
# Chromium sandbox (designer + invoice browsers): when the API runs as root,
# Chromium only starts with --no-sandbox, so a compromised renderer would run
# as root. It keeps working, but production logs an ERROR at the first launch.
# Run the API as a non-root user (e.g. `User=app` in the systemd unit, or
# `USER node` in the container image).

# ── Object storage (S3 project; plans/s3-storage/SPEC.md) ───────────────────
# Where public media (uploads/), private files (customer originals, designer
# files, importer bundles, invoice PDFs) and offsite backups live.
# local (default) = today's disk trees (<cwd>/uploads, PRIVATE_STORAGE_DIR,
# INVOICE_STORAGE_DIR, BACKUP_DIR), no behaviour change.
# s3 = the bucket(s) below; the API streams /uploads/* from the media role
# with the same cache headers, URLs and DB values do not change. Public media
# is served ONLY by the API (/uploads/*): no direct bucket URLs, no presigned
# URLs, Block Public Access stays ON.
# STORAGE_DRIVER=local
# Region of the buckets (eu-north-1 = Stockholm). Credentials come from the
# SDK default chain: AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY in this file
# (never in chat/logs; health output prints booleans only) or an IAM role.
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Buckets (globally unique names). media + private are REQUIRED with
# STORAGE_DRIVER=s3. S3_BACKUP_BUCKET is independent of the driver: when set
# (with AWS_REGION) backups go offsite even while STORAGE_DRIVER=local.
# SINGLE-BUCKET MODE (production 2026-11): all three may name the SAME bucket;
# the roles are kept apart by the key prefixes below.
# S3_MEDIA_BUCKET=shopsdoor-prod
# S3_PRIVATE_BUCKET=shopsdoor-prod
# S3_BACKUP_BUCKET=shopsdoor-prod
# Key prefix of each role inside its bucket. Unset = the default shown;
# empty = no prefix (only when the buckets differ). Normalised to end with
# "/". Two roles on the same bucket with the same prefix refuse to start.
# Keys/URLs in the DB stay role-relative (uploads/<folder>/<file>, private
# keys, invoices/<key>, db/<date>/...), so moving a role to its own bucket
# later is only an env change.
# S3_MEDIA_PREFIX=media/
# S3_PRIVATE_PREFIX=private/
# S3_BACKUP_PREFIX=backups/
# Optional KMS key (id or ARN): private + backup writes use SSE-KMS with it.
# Unset = NO encryption header is sent (not even AES256): the bucket's
# default encryption (SSE-S3, set by the AWS manager) applies.
# S3_KMS_KEY_ID=
# What to do when the IAM key may not DeleteObject (production key =
# ListBucket + GetObject + PutObject only). try (default) = send the delete,
# swallow AccessDenied with ONE warning per bucket/prefix and report
# { deleted: false, reason: 'denied' } (local copies are still removed,
# retention tasks continue); skip = never call DeleteObject. Objects are
# then removed by the bucket lifecycle.
# STORAGE_DELETE_MODE=try
# Send the tier tag + per-object GOVERNANCE lock on backup uploads. Needs
# PutObjectTagging/PutObjectRetention on the key and Object Lock on the
# bucket; false (default) = plain PutObject, retention is a bucket lifecycle
# configured by the AWS manager (INFRA.md "manager checklist").
# S3_BACKUP_OBJECT_LOCK=false
# Optional custom endpoint (minio / tests) and path-style addressing.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Dual-read during the migration: with the s3 driver a media miss on S3 falls
# back to the local uploads/ file (reads only; writes go to S3, deletes to
# both). Keep true until storage-verify passes, then set false.
# MEDIA_LOCAL_FALLBACK=true
# Optional absolute base for public media URLs (a future CDN origin, no
# trailing slash). Default: PUBLIC_API_URL. Relative /uploads/... URLs are
# still what the API stores and serves.
# MEDIA_BASE_URL=
# In s3 mode the API probes every role at boot: HeadBucket, and when the key
# may not call it (403) ListObjectsV2 MaxKeys=1 under the role prefix
# (GetBucketLocation is never called; the client uses AWS_REGION only). It
# refuses to start when media or private fails (network, 404, list refused);
# false = log and continue. The backup role only warns (offsite copies record
# offsite_error). GET /api/health reports storage.media / storage.private
# (ok|fail, cached 60 s) and storage.probe.<role> = head|list.
# STORAGE_STRICT_STARTUP=true
# Optional credentials for the backup role only (a dedicated
# `ms-backup-writer` key, INFRA.md §5.2) when the API key has no access to a
# separate backup bucket. Unset = the SDK default chain = the API key, which
# is the normal case in single-bucket mode.
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_AWS_SESSION_TOKEN=
# off = keep the sink (watchdog, restore from S3) but skip the in-app upload
# after a backup (the cron script still runs). Default: on.
# BACKUP_OFFSITE_UPLOAD=on

# ── Operability (M5 W1-C) ───────────────────────────────────────────────────
# Shared browser selection for BOTH the invoice PDF and the designer
# renderers. The per-renderer names above (INVOICE_PDF_CHROMIUM_PATH,
# DESIGNER_CHROMIUM_PATH, INVOICE_PDF_BROWSER_CHANNEL,
# DESIGNER_BROWSER_CHANNEL) keep winning when set.
# CHROMIUM_PATH="/usr/bin/chromium"
# CHROMIUM_CHANNEL=msedge
#
# One switch for the four per-instance workers (comma separated; a worker
# not in the list is off; empty or "none" = all off). The legacy flags
# RETENTION_SCHEDULER / BACKUP_SCHEDULER / IMPORTER_WORKER /
# DESIGNER_RENDER_QUEUE (DESIGNER_WORKER) win when set. Multi-instance PM2:
# every instance may run retention and backup (both take a Postgres advisory
# lock); importer and designer are DB-claimed queues (safe on several
# instances, RAM permitting). See docs/OPERATIONS.md.
# WORKERS=retention,backup,importer,designer
#
# Cross-instance StoreApp cache invalidation: every mutation runs
# pg_notify('store_apps', storeId) and each instance holds one dedicated
# LISTEN connection (DATABASE_URL). STORE_APPS_LISTEN=off disables the
# listener (the 60 s cache TTL then applies).
# STORE_APPS_LISTEN=off
#
# GET /api/admin/ops/status (ADMIN): schedulers, print queue, importer runs,
# backups, free disk, DB round trip, version/commit (GIT_COMMIT or .git/HEAD),
# cached 15 s. OPS_INSTANCE_ID names this process in the job tick table
# (default <hostname>:pm<pm_id> under PM2, else <hostname>:<pid>).
# GIT_COMMIT=
# OPS_INSTANCE_ID=
#
# Importer HTML sanitizer (M4.4 D11). Default: the allowlist sanitizer
# (sanitize-html: p, br, strong/em, lists, h2-h6, a[href title target rel],
# img[src alt width height], tables, blockquote; http/https only). Set
# "plain" ONLY in an emergency to import descriptions as plain-text
# paragraphs; switching makes every imported product UPDATE on its next run.
# IMPORTER_HTML_SANITIZER=plain
#
# Production guard: IMPORTER_ALLOW_PRIVATE_HOSTS, DESIGNER_RENDER_DUMP and
# DESIGNER_RENDER_REAL set with NODE_ENV=production log an ERROR at boot.

# Dashboard base URL (no trailing slash). Used for links in emails, Stripe
# onboarding returns and the Zoho Mail OAuth redirect back to
# <DASHBOARD_URL>/creator/zoho-mail, and as the target of the storefront
# owner "Edit" button (GET /storefront/:slug/edit-target answers absolute
# <DASHBOARD_URL>/... edit links). Default: http://localhost:3002.
# DASHBOARD_URL="https://ms-dash.iwings-digital.com"

# Zoho Mail app — every store registers ITS OWN Zoho OAuth client
# ("Server-based Application" in the Zoho API console of its data centre)
# and saves the client id + secret in the dashboard (secret encrypted at
# rest). No platform client / env credentials. The Authorized Redirect URI is
# the same for every store: <PUBLIC_API_URL>/api/zoho-mail/oauth/callback;
# set ZOHO_REDIRECT_URI only to override it.
# ZOHO_REDIRECT_URI="https://ms-api.iwings-digital.com/api/zoho-mail/oauth/callback"
