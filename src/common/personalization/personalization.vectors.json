{
  "version": 1,
  "about": "M4.0 personalization rule vectors. Source of truth: multi-stores-shared/src/personalization/. Byte copies live next to the api and web rules.ts copies; every copy runs every vector. validate cases use the default isFileRef (isFileRefPath), no isVisible and no patternTester (plain RegExp). pattern cases: valid = isValidPattern, reason = patternProblem (null when valid).",
  "charCount": [
    { "name": "ascii", "input": "ANNA", "expected": 4 },
    { "name": "empty", "input": "", "expected": 0 },
    { "name": "heart without VS16", "input": "\u2764", "expected": 1 },
    { "name": "heart with VS16 counts 1", "input": "\u2764\uFE0F", "expected": 1 },
    { "name": "text presentation selector removed", "input": "A\u2764\uFE0E", "expected": 2 },
    { "name": "astral emoji is one code point", "input": "\uD83D\uDE00", "expected": 1 },
    { "name": "ZWJ family is 5 code points", "input": "\uD83D\uDC68\u200D\uD83D\uDC69\u200D\uD83D\uDC67", "expected": 5 },
    { "name": "NFC composes e + combining acute", "input": "e\u0301", "expected": 1 },
    { "name": "swedish letters", "input": "\u00C5SA \u00D6RN", "expected": 7 },
    { "name": "arabic", "input": "\u0633\u0644\u0627\u0645", "expected": 4 },
    { "name": "spaces count", "input": "A B", "expected": 3 }
  ],
  "normalize": [
    { "name": "non-object becomes {}", "input": "Anna", "expected": {} },
    { "name": "null becomes {}", "input": null, "expected": {} },
    { "name": "array becomes {}", "input": ["a"], "expected": {} },
    { "name": "trim strings", "input": { "f1": "  Anna " }, "expected": { "f1": "Anna" } },
    { "name": "NFC strings", "input": { "f1": "Jose\u0301" }, "expected": { "f1": "Jos\u00E9" } },
    { "name": "blank and null dropped", "input": { "a": "", "b": "   ", "c": null, "d": "x" }, "expected": { "d": "x" } },
    { "name": "numbers and booleans kept", "input": { "n": 5, "z": 0, "t": true, "f": false }, "expected": { "f": false, "n": 5, "t": true, "z": 0 } },
    { "name": "array order kept, empty scalars dropped", "input": { "m": ["b", " ", "a", null, "c "] }, "expected": { "m": ["b", "a", "c"] } },
    { "name": "empty array dropped", "input": { "m": [], "n": ["", null] }, "expected": {} },
    { "name": "nested object normalized", "input": { "g": { "y": " 2 ", "x": "" } }, "expected": { "g": { "y": "2" } } },
    { "name": "empty nested object dropped as entry", "input": { "g": { "x": "" }, "h": {} }, "expected": {} },
    { "name": "object elements kept in place in arrays", "input": { "r": [{ "n": "A" }, {}, { "n": " " }, { "n": "C" }] }, "expected": { "r": [{ "n": "A" }, {}, {}, { "n": "C" }] } },
    { "name": "variation selectors kept in stored value", "input": { "f": "EVA\u2764\uFE0F" }, "expected": { "f": "EVA\u2764\uFE0F" } }
  ],
  "lineKey": [
    { "name": "empty object is ''", "a": {}, "expectedA": "" },
    { "name": "null is ''", "a": null, "expectedA": "" },
    { "name": "blank-only is ''", "a": { "f1": "  ", "f2": null }, "expectedA": "" },
    { "name": "exact encoding", "a": { "b": "x", "a": 1 }, "expectedA": "[\"v1\",null,[[\"a\",1],[\"b\",\"x\"]]]" },
    { "name": "design only", "a": {}, "aDesign": "d1", "expectedA": "[\"v1\",\"d1\",[]]" },
    { "name": "empty design id is no design", "a": {}, "aDesign": "", "expectedA": "" },
    { "name": "key order independent", "a": { "x": "1", "y": "2" }, "b": { "y": "2", "x": "1" }, "equal": true },
    { "name": "integer-like keys order independent", "a": { "10": "a", "2": "b" }, "b": { "2": "b", "10": "a" }, "equal": true },
    { "name": "trim equal", "a": { "id": "Anna " }, "b": { "id": "Anna" }, "equal": true },
    { "name": "NFC equal", "a": { "id": "Jose\u0301" }, "b": { "id": "Jos\u00E9" }, "equal": true },
    { "name": "{} equals null", "a": {}, "b": null, "equal": true },
    { "name": "blank-only equals undefined-like", "a": { "f": "" }, "b": {}, "equal": true },
    { "name": "different values differ", "a": { "f": "ANNA" }, "b": { "f": "OLLE" }, "equal": false },
    { "name": "string 5 differs from number 5", "a": { "f": "5" }, "b": { "f": 5 }, "equal": false },
    { "name": "array order matters", "a": { "m": ["a", "b"] }, "b": { "m": ["b", "a"] }, "equal": false },
    { "name": "design id changes the key", "a": { "f": "A" }, "aDesign": "d1", "b": { "f": "A" }, "equal": false },
    { "name": "different design ids differ", "a": {}, "aDesign": "d1", "b": {}, "bDesign": "d2", "equal": false },
    { "name": "heart with and without VS16 stay distinct (W17)", "a": { "f": "EVA\u2764" }, "b": { "f": "EVA\u2764\uFE0F" }, "equal": false },
    { "name": "nested key order independent", "a": { "r": [{ "x": "1", "y": "2" }] }, "b": { "r": [{ "y": "2", "x": "1" }] }, "equal": true },
    { "name": "repeater index kept", "a": { "r": [{}, { "n": "B" }] }, "b": { "r": [{ "n": "B" }] }, "equal": false },
    { "name": "object vs array of pairs differ", "a": { "g": { "a": 1 } }, "b": { "g": [["a", 1]] }, "equal": false }
  ],
  "allowedChars": [
    { "name": "preset english only", "body": "a-zA-Z\\s", "valid": true, "samples": [{ "value": "Anna Karin", "ok": true }, { "value": "Anna1", "ok": false }, { "value": "\u00C5sa", "ok": false }] },
    { "name": "preset english + heart", "body": "a-zA-Z\u2764\\s", "valid": true, "samples": [{ "value": "EVA\u2764", "ok": true }, { "value": "EVA\u2764\uFE0F", "ok": true }, { "value": "EVA!", "ok": false }] },
    { "name": "preset uppercase", "body": "A-Z\\s", "valid": true, "samples": [{ "value": "ANNA", "ok": true }, { "value": "Anna", "ok": false }] },
    { "name": "preset lowercase", "body": "a-z\\s", "valid": true, "samples": [{ "value": "anna", "ok": true }, { "value": "ANNA", "ok": false }] },
    { "name": "preset numbers", "body": "0-9", "valid": true, "samples": [{ "value": "2026", "ok": true }, { "value": "20 26", "ok": false }] },
    { "name": "preset english + numbers", "body": "a-zA-Z0-9\\s", "valid": true, "samples": [{ "value": "Klass 3B", "ok": true }, { "value": "3B!", "ok": false }] },
    { "name": "preset arabic only (escapes)", "body": "\\u0600-\\u06FF\\s", "valid": true, "samples": [{ "value": "\u0633\u0644\u0627\u0645", "ok": true }, { "value": "salam", "ok": false }] },
    { "name": "preset arabic only (literal range)", "body": "\u0600-\u06FF\\s", "valid": true, "samples": [{ "value": "\u0633\u0644\u0627\u0645 \u0639\u0644\u064A", "ok": true }, { "value": "Ali", "ok": false }] },
    { "name": "preset arabic + english", "body": "a-zA-Z\\u0600-\\u06FF\\s", "valid": true, "samples": [{ "value": "Ali \u0639\u0644\u064A", "ok": true }, { "value": "Ali 1", "ok": false }] },
    { "name": "preset phone", "body": "0-9+\\-()\\s", "valid": true, "samples": [{ "value": "+46 (70) 123-45", "ok": true }, { "value": "070abc", "ok": false }] },
    { "name": "preset no special", "body": "a-zA-Z0-9\\s", "valid": true, "samples": [{ "value": "Abc 123", "ok": true }, { "value": "Abc_123", "ok": false }] },
    { "name": "swedish letters", "body": "a-zA-Z\u00E5\u00E4\u00F6\u00C5\u00C4\u00D6\\s", "valid": true, "samples": [{ "value": "\u00C5SA \u00D6RN", "ok": true }] },
    { "name": "empty body is invalid", "body": "", "valid": false, "samples": [] },
    { "name": "unescaped closing bracket rejected", "body": "a-z]|.*[", "valid": false, "samples": [] },
    { "name": "lone opening bracket rejected", "body": "[", "valid": false, "samples": [] },
    { "name": "escaped brackets allowed", "body": "a-z\\[\\]", "valid": true, "samples": [{ "value": "a[b]", "ok": true }] },
    { "name": "invalid range rejected", "body": "z-a", "valid": false, "samples": [] },
    { "name": "invalid escape under u flag rejected", "body": "\\q", "valid": false, "samples": [] }
  ],
  "pattern": [
    { "name": "preset english only", "pattern": "^[a-zA-Z\\s]+$", "valid": true },
    { "name": "preset email", "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$", "valid": true },
    { "name": "preset phone", "pattern": "^\\+?[0-9\\s\\-()]+$", "valid": true },
    { "name": "unbalanced paren", "pattern": "^(abc$", "valid": false, "reason": "invalid" },
    { "name": "empty is not a pattern", "pattern": "", "valid": false, "reason": "invalid" },
    { "name": "date preset", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "valid": true, "reason": null },
    { "name": "optional group without nested repeat", "pattern": "^\\d+(\\.\\d{1,2})?$", "valid": true, "reason": null },
    { "name": "repeated group with disjoint alternatives", "pattern": "^(com|net|org)+$", "valid": true, "reason": null },
    { "name": "fixed repeat of a plain group", "pattern": "^(abc){3}$", "valid": true, "reason": null },
    { "name": "ReDoS: words with optional space repeated", "pattern": "^([A-Za-z]+ ?)+$", "valid": false, "reason": "unsafe" },
    { "name": "ReDoS: nested plus", "pattern": "^(a+)+$", "valid": false, "reason": "unsafe" },
    { "name": "ReDoS: non-capturing nested star", "pattern": "^(?:\\w+\\s?)*$", "valid": false, "reason": "unsafe" },
    { "name": "ReDoS: bounded repeat of a quantified group", "pattern": "^(a{1,3}){2}$", "valid": false, "reason": "unsafe" },
    { "name": "ReDoS: overlapping alternatives repeated", "pattern": "^(a|ab)*$", "valid": false, "reason": "unsafe" },
    { "name": "ReDoS: class and digit alternatives repeated", "pattern": "^(\\d|[0-9])+$", "valid": false, "reason": "unsafe" },
    { "name": "backreference refused", "pattern": "^(a)\\1$", "valid": false, "reason": "unsafe" },
    { "name": "lookahead refused", "pattern": "^(?=.*\\d)\\w+$", "valid": false, "reason": "unsafe" },
    { "name": "lookbehind refused", "pattern": "(?<!a)b", "valid": false, "reason": "unsafe" },
    { "name": "over 200 characters", "pattern": "^aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa$", "valid": false, "reason": "too_long" }
  ],
  "linkedValidation": [
    { "name": "equal_length by target", "raw": { "type": "equal_length", "target": "name_2", "fill_char": "\u2764" }, "expected": { "type": "equal_length", "target": "name_2", "fill_char": "\u2764" } },
    { "name": "legacy target_field_id read as target", "raw": { "type": "equal_length", "target_field_id": "name_2" }, "expected": { "type": "equal_length", "target": "name_2" } },
    { "name": "max_combined with max", "raw": { "type": "max_combined", "target": "name_2", "max": 20 }, "expected": { "type": "max_combined", "target": "name_2", "max": 20 } },
    { "name": "max_combined without numeric max ignored", "raw": { "type": "max_combined", "target_field_id": "20" }, "expected": null },
    { "name": "unknown type ignored", "raw": { "type": "other", "target": "x" }, "expected": null },
    { "name": "missing target ignored", "raw": { "type": "equal_length" }, "expected": null },
    { "name": "not an object", "raw": "equal_length", "expected": null },
    { "name": "fill_char of two characters ignored", "raw": { "type": "equal_length", "target": "name_2", "fill_char": "ab" }, "expected": { "type": "equal_length", "target": "name_2" } },
    { "name": "fill_char heart with VS16 counts as one", "raw": { "type": "equal_length", "target": "name_2", "fill_char": "\u2764\uFE0F" }, "expected": { "type": "equal_length", "target": "name_2", "fill_char": "\u2764\uFE0F" } }
  ],
  "fileRef": [
    { "name": "relative custom-fields", "url": "/uploads/custom-fields/0b8f2c1e-1111-4222-8333-944445555666.webp", "ok": true },
    { "name": "relative customer-previews", "url": "/uploads/customer-previews/0b8f2c1e-1111-4222-8333-944445555666.webp", "ok": true },
    { "name": "absolute https", "url": "https://api.example.com/uploads/customer-uploads/a.pdf", "ok": true },
    { "name": "other folder", "url": "/uploads/products/a.webp", "ok": false },
    { "name": "path traversal", "url": "/uploads/custom-fields/../../etc/passwd", "ok": false },
    { "name": "dot file", "url": "/uploads/custom-fields/.hidden", "ok": false },
    { "name": "query string", "url": "https://x.com/uploads/custom-fields/a.webp?x=1", "ok": false },
    { "name": "javascript url", "url": "javascript:alert(1)", "ok": false },
    { "name": "plain text", "url": "http://my-site", "ok": false }
  ],
  "validate": [
    {
      "name": "no fields, no values",
      "fields": [],
      "values": {},
      "expected": { "ok": true, "issues": [], "values": {} }
    },
    {
      "name": "no fields, unknown keys dropped",
      "fields": [],
      "values": { "stale-id": "Anna" },
      "expected": { "ok": true, "issues": [], "values": {} }
    },
    {
      "name": "null values means none",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false }],
      "values": null,
      "expected": { "ok": true, "issues": [], "values": {} }
    },
    {
      "name": "payload must be an object",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false }],
      "values": "Anna",
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_PAYLOAD", "field_id": "", "field_name": "" }], "values": {} }
    },
    {
      "name": "payload array rejected",
      "fields": [],
      "values": ["Anna"],
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_PAYLOAD", "field_id": "", "field_name": "" }], "values": {} }
    },
    {
      "name": "required missing",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": true }],
      "values": {},
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_REQUIRED", "field_id": "f1", "field_name": "name_1" }], "values": {} }
    },
    {
      "name": "required whitespace-only rejected",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": true }],
      "values": { "f1": "   " },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_REQUIRED", "field_id": "f1", "field_name": "name_1" }], "values": {} }
    },
    {
      "name": "optional empty ok",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "min_length": 3 } }],
      "values": { "f1": "" },
      "expected": { "ok": true, "issues": [], "values": {} }
    },
    {
      "name": "text trimmed and stored normalized",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": true }],
      "values": { "f1": "  Anna  ", "stale": "x" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "Anna" } }
    },
    {
      "name": "too short",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "min_length": 3 } }],
      "values": { "f1": "AB" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_TOO_SHORT", "field_id": "f1", "field_name": "name_1", "params": { "min": 3 } }] }
    },
    {
      "name": "too long",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "max_length": 11 } }],
      "values": { "f1": "ABCDEFGHIJKL" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_TOO_LONG", "field_id": "f1", "field_name": "name_1", "params": { "max": 11 } }] }
    },
    {
      "name": "legacy string bounds read",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "max_length": "4" } }],
      "values": { "f1": "ABCDE" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_TOO_LONG", "field_id": "f1", "field_name": "name_1", "params": { "max": 4 } }] }
    },
    {
      "name": "heart with VS16 fits max 4",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "max_length": 4 } }],
      "values": { "f1": "EVA\u2764\uFE0F" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "EVA\u2764\uFE0F" } }
    },
    {
      "name": "astral emoji counted as one",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXTAREA", "is_required": false, "validation_rules": { "max_length": 2 } }],
      "values": { "f1": "\uD83D\uDE00\uD83D\uDE00" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "\uD83D\uDE00\uD83D\uDE00" } }
    },
    {
      "name": "pattern mismatch",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "pattern": "^[A-Z]+$" } }],
      "values": { "f1": "Anna" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_FORMAT", "field_id": "f1", "field_name": "name_1" }] }
    },
    {
      "name": "invalid merchant pattern ignored",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "pattern": "^(abc$" } }],
      "values": { "f1": "Anna" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "Anna" } }
    },
    {
      "name": "pattern only applies to text types",
      "fields": [{ "id": "f1", "name": "colour", "type": "COLOR", "is_required": false, "validation_rules": { "pattern": "^[A-Z]+$" } }],
      "values": { "f1": "#ff0000" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "#ff0000" } }
    },
    {
      "name": "allowed chars rejected",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "allowed_chars": "A-Za-z\u2764" } }],
      "values": { "f1": "ANNA!" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_CHARS", "field_id": "f1", "field_name": "name_1", "params": { "allowed": "A-Za-z\u2764" } }] }
    },
    {
      "name": "allowed chars accepts heart with VS16",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "allowed_chars": "A-Za-z\u2764" } }],
      "values": { "f1": "EVA\u2764\uFE0F" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "EVA\u2764\uFE0F" } }
    },
    {
      "name": "invalid allowed chars ignored at runtime",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false, "validation_rules": { "allowed_chars": "a-z]|.*[" } }],
      "values": { "f1": "ANNA!" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "ANNA!" } }
    },
    {
      "name": "text given an object",
      "fields": [{ "id": "f1", "name": "name_1", "type": "TEXT", "is_required": false }],
      "values": { "f1": { "x": "y" } },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_PAYLOAD", "field_id": "f1", "field_name": "name_1" }] }
    },
    {
      "name": "number ok as string",
      "fields": [{ "id": "f1", "name": "age", "type": "NUMBER", "is_required": true, "validation_rules": { "min_length": 1, "max_length": 99 } }],
      "values": { "f1": " 42 " },
      "expected": { "ok": true, "issues": [], "values": { "f1": "42" } }
    },
    {
      "name": "number invalid",
      "fields": [{ "id": "f1", "name": "age", "type": "NUMBER", "is_required": false }],
      "values": { "f1": "4x" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_NUMBER", "field_id": "f1", "field_name": "age" }] }
    },
    {
      "name": "number with a decimal comma (stored as typed)",
      "fields": [{ "id": "f1", "name": "size", "type": "NUMBER", "is_required": true, "validation_rules": { "min_length": 1, "max_length": 2 } }],
      "values": { "f1": "1,5" },
      "expected": { "ok": true, "issues": [], "values": { "f1": "1,5" } }
    },
    {
      "name": "number with a decimal comma checks bounds",
      "fields": [{ "id": "f1", "name": "size", "type": "NUMBER", "is_required": false, "validation_rules": { "max_length": 2 } }],
      "values": { "f1": "2,5" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_NUMBER_TOO_LARGE", "field_id": "f1", "field_name": "size", "params": { "max": 2 } }] }
    },
    {
      "name": "number with two commas is invalid",
      "fields": [{ "id": "f1", "name": "size", "type": "NUMBER", "is_required": false }],
      "values": { "f1": "1,5,6" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_NUMBER", "field_id": "f1", "field_name": "size" }] }
    },
    {
      "name": "number with comma and point is invalid",
      "fields": [{ "id": "f1", "name": "size", "type": "NUMBER", "is_required": false }],
      "values": { "f1": "1.000,5" },
      "expected": { "ok": false, "issues": [{ "code": "CUSTOM_FIELD_INVALID_NUMBER", "field_id": "f1", "field_name": "size" }] }
    },
    {
      "name": "number too small",
